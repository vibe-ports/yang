#!/usr/bin/env bash
# Run any command inside the dev container: ./dev make ci, ./dev go test ./..., ./dev (shell).
# DEV_PLATFORM=linux/amd64 ./dev … runs the container for that platform (emulated on Apple
# silicon). Canonical oracle output (goldens, internal/xpath/testdata) comes from linux/amd64:
#   DEV_PLATFORM=linux/amd64 ./dev make oracle-golden
# Personal sensitive-data patterns are deliberately NOT passed in: they stay on the host and are
# checked by the git hooks (scripts/check-sensitive on the host, see CONTRIBUTING.md).
set -euo pipefail
cd "$(dirname "$0")"
plat=() tag=yang-dev
if [ -n "${DEV_PLATFORM:-}" ]; then
  plat=(--platform "$DEV_PLATFORM") tag="yang-dev-${DEV_PLATFORM//\//-}"
fi
docker build -q "${plat[@]}" --target dev -t "$tag" . >/dev/null
tty=(-i); [ -t 0 ] && tty=(-it)   # -i always: `echo … | ./dev cmd` passes stdin
exec docker run --rm "${tty[@]}" "${plat[@]}" \
  -v "$PWD":/workspaces/yang -v yang-gomod:/home/dev/go/pkg/mod -v "${tag/yang-dev/yang-gocache}":/home/dev/.cache \
  -e FUZZTIME "$tag" "${@:-bash}"
