#!/usr/bin/env bash
# Run any command inside the dev container: ./dev make ci, ./dev go test ./..., ./dev (shell).
set -euo pipefail
cd "$(dirname "$0")"
docker build -q --target dev -t yang-dev . >/dev/null
tty=(); [ -t 0 ] && tty=(-it)
exec docker run --rm "${tty[@]}" \
  -v "$PWD":/workspaces/yang -v yang-gomod:/go/pkg/mod -v yang-gocache:/home/dev/.cache \
  -e FUZZTIME yang-dev "${@:-bash}"
