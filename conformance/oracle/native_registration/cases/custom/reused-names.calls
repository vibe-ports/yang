# All built-in names reused with different node kinds.
context module m {yang-version 1.1;namespace urn:m;prefix m;leaf c {type string;}leaf d {type string;}leaf r {type string;}leaf l {type string;}leaf kl {type string;}leaf i {type string;}leaf j {type string;}leaf other {type string;}leaf input {type string;}leaf output {type string;}container p {presence yes;}container q {presence yes;}container ll {presence yes;}container v {presence yes;}container z {presence yes;}container a {presence yes;}container a2 {presence yes;}container o {presence yes;}container k {presence yes;}container x {presence yes;}container def {presence yes;}}
term 1 0 c A
read-schema 1 1 0
read-instance 1 1 0
equal 1 1 1
print 1
