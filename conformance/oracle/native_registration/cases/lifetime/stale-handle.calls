# A script-visible descendant remains a tombstoned handle after recursive free.
root 1 c
print 1
root 2 c
term 11 2 p P
term 12 2 q Q
term 13 2 ll QQ==
term 14 2 ll Qg==
# Reserve the actual freed handle-14 chunk until the forced constructor.
free 2 14
term 101 1 p P
free 101
term 102 1 p P
free 102
term 103 1 p P
free 103
# Force reuse of the actual freed handle-14 chunk before the native calloc.
term 104 1 p P 0 14
# Handle 14 has been freed with its parent and its raw address now names 104.
check-handle 14
