      "compiled": "module pcr {\n  namespace \"urn:tests:pcr\";\n  prefix pcr;\n\n  description\n    \"Common pattern shapes that rely on libyang's PCRE2 syntax.\";\n\n  leaf hexr {\n    type string {\n      pattern \"[\\\\x20-\\\\x7F]*\";\n    }\n    config true;\n    status current;\n  }\n  leaf punct {\n    type string {\n      pattern \"[a-zA-Z0-9\\\\-_\\\\/\\\\.\\\\%\\\\!\\\\?\\\\:]*\";\n    }\n    config true;\n    status current;\n  }\n  leaf caretr {\n    type string {\n      pattern \"[a-z0-9\\\\-\\\\^]*\";\n    }\n    config true;\n    status current;\n  }\n  leaf dcls {\n    type string {\n      pattern \"[\\\\d]+\";\n    }\n    config true;\n    status current;\n  }\n  leaf wcls {\n    type string {\n      pattern \"[\\\\w]+\";\n    }\n    config true;\n    status current;\n  }\n  leaf dout {\n    type string {\n      pattern \"\\\\d+\";\n    }\n    config true;\n    status current;\n  }\n  leaf wout {\n    type string {\n      pattern \"\\\\w+\";\n    }\n    config true;\n    status current;\n  }\n}\n",
