      "compiled": "module must-operand-node-type {\n  namespace \"urn:vibe-ports:yang:conformance:must-operand-node-type\";\n  prefix mont;\n\n  container top {\n    must \"c1 = 1\";\n    must \"n + c1\";\n    must \"-c1 > 0\";\n    must \"l = ll\";\n    must \"n * 2 = 4 and 1 < c1/in and c1 != 3\";\n    config true;\n    status current;\n    leaf n {\n      type uint8;\n      config true;\n      status current;\n    }\n    container c1 {\n      config true;\n      status current;\n      leaf in {\n        type uint8;\n        config true;\n        status current;\n      }\n    }\n    list l {\n      key \"k\";\n      config true;\n      min-elements 0;\n      max-elements 4294967295;\n      ordered-by system;\n      status current;\n      leaf k {\n        type string;\n        config true;\n        status current;\n      }\n    }\n    leaf-list ll {\n      type uint8;\n      config true;\n      min-elements 0;\n      max-elements 4294967295;\n      ordered-by system;\n      status current;\n    }\n  }\n}\n",
