      "compiled": "module must-value-nofit-sides {\n  namespace \"urn:vibe-ports:yang:conformance:must-value-nofit-sides\";\n  prefix mvns;\n\n  container top {\n    must \"300 = n\";\n    must \"ll != 'x'\";\n    must \"e = 'blue'\";\n    must \"u = 'huge' or u != -1\";\n    must \"s = 'toolong'\";\n    must \"n = 1 + 'x'\";\n    must \"n = 1 and 'abc' = n and e = 'red'\";\n    config true;\n    status current;\n    leaf n {\n      type uint8;\n      config true;\n      status current;\n    }\n    leaf-list ll {\n      type int8;\n      config true;\n      min-elements 0;\n      max-elements 4294967295;\n      ordered-by system;\n      status current;\n    }\n    leaf e {\n      type enumeration {\n        enum \"red\" {\n          value 0;\n          status current;\n        }\n        enum \"green\" {\n          value 1;\n          status current;\n        }\n      }\n      config true;\n      status current;\n    }\n    leaf u {\n      type union {\n        type uint8;\n        type enumeration {\n          enum \"big\" {\n            value 0;\n            status current;\n          }\n        }\n      }\n      config true;\n      status current;\n    }\n    leaf s {\n      type string {\n        length \"1..3\";\n      }\n      config true;\n      status current;\n    }\n  }\n}\n",
