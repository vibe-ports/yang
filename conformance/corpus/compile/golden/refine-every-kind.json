      "compiled": "module refine-every-kind {\n  namespace \"urn:vibe-ports:yang:conformance:refine-every-kind\";\n  prefix refine-every-kind;\n\n  container c {\n    config true;\n    status current;\n    leaf l {\n      type string;\n      default \"hello\";\n      config false;\n      status current;\n    }\n    leaf-list ll {\n      type string;\n      default \"hello\";\n      default \"world\";\n      config true;\n      min-elements 0;\n      max-elements 5;\n      ordered-by system;\n      status current;\n    }\n    choice ch {\n      default \"cb\";\n      config true;\n      status current;\n      case ca {\n        config true;\n        status current;\n        leaf ca {\n          type int8;\n          config true;\n          status current;\n        }\n      }\n      case cb {\n        config true;\n        status current;\n        leaf cb {\n          type uint8;\n          config true;\n          status current;\n        }\n      }\n    }\n    leaf x {\n      type string;\n      must \"1\";\n      must \"../ll\";\n      default \"cheers!\";\n      config true;\n      mandatory false;\n      status current;\n      description\n        \"refined\";\n      reference\n        \"refined\";\n    }\n    anydata a {\n      must \"1\";\n      config true;\n      mandatory true;\n      status current;\n      description\n        \"refined\";\n      reference\n        \"refined\";\n    }\n    container c {\n      presence \"true\";\n      config true;\n      status current;\n      leaf l {\n        type string;\n        config true;\n        status current;\n      }\n    }\n  }\n}\n",
