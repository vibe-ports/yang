      "accepted": true,
      "compiled": "module pv2 {\n  namespace \"urn:vibe-ports:yang:conformance:pv2\";\n  prefix p;\n\n  description\n    \"Hand-written module exercising oracle protocol v2 dumps: when auto-delete,\n     implicit defaults, choice default case, unions, anydata, identities.\";\n\n  identity base-id {\n    derived one;\n  }\n\n  identity one {\n    derived two;\n  }\n\n  identity two {\n  }\n\n  container c {\n    config true;\n    status current;\n    leaf mode {\n      pv2:note \"switches x\";\n      type enumeration {\n        enum \"on\" {\n          value 0;\n          status current;\n        }\n        enum \"off\" {\n          value 5;\n          status current;\n        }\n      }\n      config true;\n      status current;\n    }\n    leaf x {\n      when \"../mode = 'on'\";\n      type string;\n      config true;\n      status current;\n    }\n    leaf u {\n      type union {\n        type int8;\n        type uint8 {\n          range \"0..100\";\n        }\n        type string {\n          length \"1..8\";\n          pattern \"[a-z]+\";\n        }\n      }\n      config true;\n      status current;\n    }\n    leaf d {\n      type uint8 {\n        range \"0..100\";\n      }\n      default \"07\";\n      config true;\n      status current;\n    }\n    leaf dec {\n      type decimal64 {\n        fraction-digits 2;\n        range \"-150..1000 | 2000\";\n      }\n      config true;\n      status current;\n    }\n    leaf id {\n      type identityref {\n        base base-id;\n      }\n      config true;\n      status current;\n    }\n    choice ch {\n      default \"first\";\n      config true;\n      status current;\n      case first {\n        config true;\n        status current;\n        leaf f {\n          type string;\n          default \"ff\";\n          config true;\n          status current;\n        }\n      }\n      case second {\n        config true;\n        status current;\n        leaf s {\n          type string;\n          config true;\n          status current;\n        }\n      }\n    }\n    list l {\n      key \"k\";\n      config true;\n      min-elements 0;\n      max-elements 3;\n      ordered-by user;\n      status current;\n      leaf k {\n        type string;\n        config true;\n        status current;\n      }\n      action reset {\n        status current;\n\n        input {\n          leaf why {\n            type string;\n            status current;\n          }\n        }\n\n        output {\n          leaf done {\n            type boolean;\n            status current;\n          }\n        }\n      }\n      notification changed {\n        status current;\n        leaf what {\n          type string;\n          status current;\n        }\n      }\n    }\n    list stats {\n      config false;\n      min-elements 0;\n      max-elements 4294967295;\n      ordered-by user;\n      status current;\n      leaf hits {\n        type uint32;\n        config false;\n        status current;\n      }\n    }\n    container pres {\n      presence \"true\";\n      config true;\n      status current;\n      leaf name {\n        type string;\n        config true;\n        mandatory true;\n        status current;\n      }\n    }\n    leaf grouped {\n      type string;\n      config true;\n      status current;\n    }\n    leaf ref {\n      type leafref {\n        path \"../l/k\";\n        require-instance true;\n        type string;\n      }\n      config true;\n      status current;\n    }\n    leaf dref {\n      type leafref {\n        path \"../d\";\n        require-instance true;\n        type uint8 {\n          range \"0..100\";\n        }\n      }\n      default \"007\";\n      config true;\n      status current;\n    }\n    leaf u2 {\n      type union {\n        type uint8 {\n          range \"0..100\";\n        }\n        type leafref {\n          path \"../l/k\";\n          require-instance true;\n          type string;\n        }\n      }\n      config true;\n      status current;\n    }\n    leaf-list ll {\n      type string;\n      default \"a\";\n      default \"b\";\n      config true;\n      min-elements 0;\n      max-elements 4294967295;\n      ordered-by system;\n      status current;\n    }\n    leaf flags {\n      type bits {\n        bit \"x\" {\n          position 0;\n          status current;\n        }\n        bit \"y\" {\n          position 3;\n          status current;\n        }\n      }\n      config true;\n      status current;\n    }\n    anydata any {\n      config true;\n      status current;\n    }\n    leaf extra {\n      when \"p:mode = 'on'\";\n      type string;\n      config true;\n      status current;\n    }\n    leaf grouped {\n      when \"p:mode = 'on'\";\n      type string;\n      default \"g\";\n      config true;\n      status current;\n    }\n  }\n\n  rpc ping {\n    status current;\n\n    input {\n      leaf n {\n        type uint8;\n        must \". < 10\" {\n          error-message\n            \"too many\";\n          error-app-tag \"too-many\";\n        }\n        status current;\n      }\n    }\n\n    output {\n      leaf rtt {\n        type uint32;\n        status current;\n      }\n    }\n  }\n\n  notification alarm {\n    status current;\n    leaf sev {\n      type uint8;\n      status current;\n    }\n  }\n}\n",
