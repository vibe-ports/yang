      "compiled": "module un {\n  namespace \"urn:vibe-ports:un\";\n  prefix un;\n\n  description\n    \"Nested unions are flattened in member order; a nested leafref member keeps its index.\";\n\n  leaf x {\n    type uint16;\n    config true;\n    status current;\n  }\n  leaf n {\n    type union {\n      type string {\n        length \"1\";\n      }\n      type int8;\n      type leafref {\n        path \"../x\";\n        require-instance true;\n        type uint16;\n      }\n      type boolean;\n      type int8;\n      type leafref {\n        path \"../x\";\n        require-instance true;\n        type uint16;\n      }\n      type empty;\n    }\n    config true;\n    status current;\n  }\n  leaf n2 {\n    type union {\n      type string {\n        length \"1\";\n      }\n      type int8;\n      type leafref {\n        path \"../x\";\n        require-instance true;\n        type uint16;\n      }\n      type boolean;\n    }\n    config true;\n    status current;\n  }\n}\n",
