      "compiled": "module tr {\n  namespace \"urn:vibe-ports:tr\";\n  prefix tr;\n\n  description\n    \"Typedef reuse rule (libyang schema_compile_node.c lys_compile_type): a typedef that adds\n     nothing reuses its base's compiled type and name; one with restrictions gets its own name;\n     a leaf type with restrictions is named after the nearest typedef.\";\n\n  container c {\n    config true;\n    status current;\n    leaf a {\n      type uint8 {\n        range \"0..100\";\n      }\n      units \"percent\";\n      config true;\n      status current;\n    }\n    leaf b {\n      type uint8 {\n        range \"0..100\";\n      }\n      units \"percent\";\n      config true;\n      status current;\n    }\n    leaf s {\n      type uint8 {\n        range \"1..10\";\n      }\n      units \"percent\";\n      config true;\n      status current;\n    }\n    leaf s2 {\n      type uint8 {\n        range \"1..10\";\n      }\n      units \"tiny\";\n      config true;\n      status current;\n    }\n    leaf r {\n      type uint8 {\n        range \"2..3\";\n      }\n      units \"percent\";\n      config true;\n      status current;\n    }\n    leaf l {\n      type uint8 {\n        range \"0..100\";\n      }\n      units \"percent\";\n      config true;\n      status current;\n    }\n    leaf st {\n      type string {\n        length \"1..8\";\n        pattern \"[a-z]*\";\n        pattern \"a.*\";\n      }\n      config true;\n      status current;\n    }\n    leaf st2 {\n      type string {\n        length \"2..3\";\n        pattern \"[a-z]*\";\n        pattern \"a.*\";\n      }\n      config true;\n      status current;\n    }\n    leaf d {\n      type decimal64 {\n        fraction-digits 2;\n        range \"-150..1000 | 2000\";\n      }\n      config true;\n      status current;\n    }\n    leaf d3 {\n      type decimal64 {\n        fraction-digits 2;\n        range \"100..200\";\n      }\n      config true;\n      status current;\n    }\n    leaf col {\n      type enumeration {\n        enum \"blue\" {\n          value 6;\n          status current;\n        }\n        enum \"green\" {\n          value 5;\n          status current;\n        }\n      }\n      default \"green\";\n      config true;\n      status current;\n    }\n    leaf col2 {\n      type enumeration {\n        enum \"red\" {\n          value 0;\n          status current;\n        }\n        enum \"green\" {\n          value 5;\n          status current;\n        }\n        enum \"blue\" {\n          value 6;\n          status current;\n        }\n      }\n      default \"green\";\n      config true;\n      status current;\n    }\n    leaf fl {\n      type bits {\n        bit \"a\" {\n          position 0;\n          status current;\n        }\n        bit \"b\" {\n          position 7;\n          status current;\n        }\n        bit \"c\" {\n          position 8;\n          status current;\n        }\n      }\n      config true;\n      status current;\n    }\n    leaf fl2 {\n      type bits {\n        bit \"b\" {\n          position 7;\n          status current;\n        }\n        bit \"c\" {\n          position 8;\n          status current;\n        }\n      }\n      config true;\n      status current;\n    }\n    leaf u {\n      type union {\n        type uint8 {\n          range \"0..100\";\n        }\n        type string {\n          length \"1..8\";\n          pattern \"[a-z]*\";\n        }\n        type boolean;\n        type decimal64 {\n          fraction-digits 2;\n          range \"-150..1000 | 2000\";\n        }\n      }\n      config true;\n      status current;\n    }\n    leaf plain {\n      type uint8;\n      units \"own\";\n      config true;\n      status current;\n    }\n  }\n}\n",
