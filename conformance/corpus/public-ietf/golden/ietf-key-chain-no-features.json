    {
      "accepted": true,
      "compiled": "module ietf-key-chain {\n  namespace \"urn:ietf:params:xml:ns:yang:ietf-key-chain\";\n  prefix key-chain;\n\n  organization\n    \"IETF RTGWG - Routing Area Working Group\";\n  contact\n    \"WG Web:   <https://datatracker.ietf.org/group/rtgwg>\n     WG List:  <mailto:rtgwg@ietf.org>\n\n     Editor: Acee Lindem\n             <mailto:acee@cisco.com>\n             Yingzhen Qu\n             <mailto:yingzhen.qu@huawei.com>\n             Derek Yeung\n             <mailto:derek@arrcus.com>\n             Ing-Wher Chen\n             <mailto:Ing-Wher_Chen@jabail.com>\n             Jeffrey Zhang\n             <mailto:zzhang@juniper.net>\";\n  description\n    \"This YANG module defines the generic configuration\n     data for key chains.  It is intended that the module\n     will be extended by vendors to define vendor-specific\n     key chain configuration parameters.\n\n     Copyright (c) 2017 IETF Trust and the persons identified as\n     authors of the code.  All rights reserved.\n\n     Redistribution and use in source and binary forms, with or\n     without modification, is permitted pursuant to, and subject\n     to the license terms contained in, the Simplified BSD License\n     set forth in Section 4.c of the IETF Trust's Legal Provisions\n     Relating to IETF Documents\n     (http://trustee.ietf.org/license-info).\n\n     This version of this YANG module is part of RFC 8177;\n     see the RFC itself for full legal notices.\";\n  reference\n    \"RFC 8177\";\n\n  revision 2017-06-15;\n\n  identity crypto-algorithm {\n    derived hmac-sha-1-12;\n    derived aes-cmac-prf-128;\n    derived md5;\n    derived sha-1;\n    derived hmac-sha-1;\n    derived hmac-sha-256;\n    derived hmac-sha-384;\n    derived hmac-sha-512;\n    derived cleartext;\n    derived replay-protection-only;\n    description\n      \"Base identity of cryptographic algorithm options.\";\n  }\n\n  identity hmac-sha-1-12 {\n    /* identity \"hmac-sha-1-12\" is disabled by if-feature(s) */\n    description\n      \"The HMAC-SHA1-12 algorithm.\";\n  }\n\n  identity aes-cmac-prf-128 {\n    /* identity \"aes-cmac-prf-128\" is disabled by if-feature(s) */\n    description\n      \"The AES-CMAC-PRF-128 algorithm - required by\n       RFC 5926 for TCP-AO key derivation functions.\";\n  }\n\n  identity md5 {\n    description\n      \"The MD5 algorithm.\";\n  }\n\n  identity sha-1 {\n    description\n      \"The SHA-1 algorithm.\";\n  }\n\n  identity hmac-sha-1 {\n    description\n      \"HMAC-SHA-1 authentication algorithm.\";\n  }\n\n  identity hmac-sha-256 {\n    description\n      \"HMAC-SHA-256 authentication algorithm.\";\n  }\n\n  identity hmac-sha-384 {\n    description\n      \"HMAC-SHA-384 authentication algorithm.\";\n  }\n\n  identity hmac-sha-512 {\n    description\n      \"HMAC-SHA-512 authentication algorithm.\";\n  }\n\n  identity cleartext {\n    /* identity \"cleartext\" is disabled by if-feature(s) */\n    description\n      \"cleartext.\";\n  }\n\n  identity replay-protection-only {\n    /* identity \"replay-protection-only\" is disabled by if-feature(s) */\n    description\n      \"Provide replay protection without any authentication as\n       required by protocols such as Bidirectional Forwarding\n       Detection (BFD).\";\n  }\n\n  container key-chains {\n    config true;\n    status current;\n    description\n      \"All configured key-chains on the device.\";\n    list key-chain {\n      key \"name\";\n      config true;\n      min-elements 0;\n      max-elements 4294967295;\n      ordered-by system;\n      status current;\n      description\n        \"List of key-chains.\";\n      leaf name {\n        type string;\n        config true;\n        status current;\n        description\n          \"Name of the key-chain.\";\n      }\n      leaf description {\n        type string;\n        config true;\n        status current;\n        description\n          \"A description of the key-chain\";\n      }\n      leaf last-modified-timestamp {\n        type string {\n          pattern \"[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\\\.[0-9]+)?(Z|[\\\\+\\\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?\";\n        }\n        config false;\n        status current;\n        description\n          \"Timestamp of the most recent update to the key-chain\";\n      }\n      list key {\n        key \"key-id\";\n        config true;\n        min-elements 0;\n        max-elements 4294967295;\n        ordered-by system;\n        status current;\n        description\n          \"Single key in key chain.\";\n        leaf key-id {\n          type uint64;\n          config true;\n          status current;\n          description\n            \"Numeric value uniquely identifying the key\";\n        }\n        container lifetime {\n          config true;\n          status current;\n          description\n            \"Specify a key's lifetime.\";\n          choice lifetime {\n            config true;\n            status current;\n            description\n              \"Options for specification of send and accept\n               lifetimes.\";\n            case send-and-accept-lifetime {\n              config true;\n              status current;\n              description\n                \"Send and accept key have the same lifetime.\";\n              container send-accept-lifetime {\n                config true;\n                status current;\n                description\n                  \"Single lifetime specification for both\n                   send and accept lifetimes.\";\n                choice lifetime {\n                  default \"always\";\n                  config true;\n                  status current;\n                  description\n                    \"Options for specifying key accept or send lifetimes\";\n                  case always {\n                    config true;\n                    status current;\n                    leaf always {\n                      type empty;\n                      config true;\n                      status current;\n                      description\n                        \"Indicates key lifetime is always valid.\";\n                    }\n                  }\n                  case start-end-time {\n                    config true;\n                    status current;\n                    leaf start-date-time {\n                      type string {\n                        pattern \"[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\\\.[0-9]+)?(Z|[\\\\+\\\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?\";\n                      }\n                      config true;\n                      status current;\n                      description\n                        \"Start time.\";\n                    }\n                    choice end-time {\n                      default \"infinite\";\n                      config true;\n                      status current;\n                      description\n                        \"End-time setting.\";\n                      case infinite {\n                        config true;\n                        status current;\n                        leaf no-end-time {\n                          type empty;\n                          config true;\n                          status current;\n                          description\n                            \"Indicates key lifetime end-time is infinite.\";\n                        }\n                      }\n                      case duration {\n                        config true;\n                        status current;\n                        leaf duration {\n                          type uint32 {\n                            range \"1..2147483646\";\n                          }\n                          units \"seconds\";\n                          config true;\n                          status current;\n                          description\n                            \"Key lifetime duration, in seconds\";\n                        }\n                      }\n                      case end-date-time {\n                        config true;\n                        status current;\n                        leaf end-date-time {\n                          type string {\n                            pattern \"[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\\\.[0-9]+)?(Z|[\\\\+\\\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?\";\n                          }\n                          config true;\n                          status current;\n                          description\n                            \"End time.\";\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n        leaf crypto-algorithm {\n          type identityref {\n            base crypto-algorithm;\n          }\n          config true;\n          mandatory true;\n          status current;\n          description\n            \"Cryptographic algorithm associated with key.\";\n        }\n        container key-string {\n          ietf-netconf-acm:default-deny-all;\n          config true;\n          status current;\n          description\n            \"The key string.\";\n          choice key-string-style {\n            ietf-netconf-acm:default-deny-all;\n            config true;\n            status current;\n            description\n              \"Key string styles\";\n            case keystring {\n              ietf-netconf-acm:default-deny-all;\n              config true;\n              status current;\n              leaf keystring {\n                ietf-netconf-acm:default-deny-all;\n                type string;\n                config true;\n                status current;\n                description\n                  \"Key string in ASCII format.\";\n              }\n            }\n          }\n        }\n        leaf send-lifetime-active {\n          type boolean;\n          config false;\n          status current;\n          description\n            \"Indicates if the send lifetime of the\n             key-chain key is currently active.\";\n        }\n        leaf accept-lifetime-active {\n          type boolean;\n          config false;\n          status current;\n          description\n            \"Indicates if the accept lifetime of the\n             key-chain key is currently active.\";\n        }\n      }\n    }\n  }\n}\n",
