    {
      "accepted": true,
      "compiled": "module basic {\n  namespace \"urn:vibe-ports:yang:conformance:basic\";\n  prefix b;\n\n  description\n    \"Hand-written seed fixture module for the yang oracle corpus.\";\n\n  container sys {\n    config true;\n    status current;\n    leaf mtu {\n      type uint16 {\n        range \"68..9000\";\n      }\n      config true;\n      status current;\n    }\n    list iface {\n      key \"name\";\n      config true;\n      min-elements 0;\n      max-elements 4294967295;\n      ordered-by system;\n      status current;\n      leaf name {\n        type string;\n        config true;\n        status current;\n      }\n      leaf type {\n        type string;\n        config true;\n        status current;\n      }\n    }\n    leaf primary {\n      type leafref {\n        path \"../iface/name\";\n        require-instance true;\n        type string;\n      }\n      config true;\n      status current;\n    }\n    leaf jumbo-frames {\n      when \"../mtu > 1500\";\n      type boolean;\n      config true;\n      status current;\n    }\n    leaf min {\n      type uint8;\n      config true;\n      status current;\n    }\n    leaf max {\n      type uint8;\n      must \". >= ../min\" {\n        error-message\n          \"max must not be below min\";\n        error-app-tag \"max-below-min\";\n      }\n      config true;\n      status current;\n    }\n    container user {\n      presence \"true\";\n      config true;\n      status current;\n      leaf name {\n        type string;\n        config true;\n        mandatory true;\n        status current;\n      }\n      leaf shell {\n        type string;\n        default \"/bin/sh\";\n        config true;\n        status current;\n      }\n    }\n  }\n}\n",
