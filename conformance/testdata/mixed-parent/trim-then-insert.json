{
  "id": "seq/mixed-parent-trim-then-insert",
  "source": {"url": "hand-written (this repo)", "commit": null, "license": "BSD-3-Clause"},
  "request": {
    "op": "sequence",
    "searchdirs": ["schemas"],
    "modules": [{"name": "pv2-edit"}, {"name": "a"}],
    "steps": [
      {"do": "parse", "data": "{\"pv2-edit:c\":{\"a\":\"x\",\"b\":1,\"l\":[{\"k\":\"x\"}]}}", "parse_only": true},
      {"do": "edit", "set": {"parent": "/pv2-edit:c/l[k='x']", "path": "/a:foo", "value": "42"}},
      {"do": "trim", "xpath": "/pv2-edit:c/a | /pv2-edit:c/b"},
      {"do": "edit", "set": {"parent": "/pv2-edit:c", "path": "np/d", "value": "7"}},
      {"do": "dump"}
    ]
  },
  "want_rc": "LY_SUCCESS",
  "want_json_order": ["\"a\"", "\"b\"", "\"np\""],
  "want_xml_order": ["<a>", "<b>", "<np>"]
}
