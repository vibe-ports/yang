#!/usr/bin/env python3
"""Advisory triage with Jev (TypeSafe). Never a gate: with no TYPESAFE_API_KEY, an API error or a
malformed answer it exits 0 and adds nothing. Never sends repository code; see CONTRIBUTING "Jev triage" for exactly what is sent.

  scripts/jev-triage drift <commits.json|->   upstream libyang commits -> annotated, sorted markdown list
      input: [{"sha","url","subject","files":["src/x.c",…],"functions":["fn",…]}, …]
      sent to Jev: the commit subject + touched src/ paths. touches_ported is computed here from
      docs/port-map.md (file level when no function names are known), not by Jev.
      Without a key the list is printed unannotated and in the original order.
  scripts/jev-triage issue <number>           label an issue (area:*, size:*, worker:*, triage:needs-human)
      only issues authored by the maintainer (MAINTAINER_ID, default 1056050); title + body[:4 KB]
      sent to Jev. Labels applied only when the top probability >= JEV_MIN (default 0.6); any
      lower one adds triage:needs-human. Needs gh (GH_TOKEN, GH_REPO).
"""
import json, os, re, subprocess, sys, time

API = "https://api.typesafe.ai/v1/systemone"
MIN = float(os.environ.get("JEV_MIN", "0.6"))
BODY_MAX = 4096
BUDGET = float(os.environ.get("JEV_BUDGET", "300"))  # total seconds for all drift calls
MAX_FAILS = 3  # consecutive failed calls before drift stops asking
CHOICES = {
    "area": {"parser": "YANG text parsing", "schema": "schema compilation and tree", "types": "built-in and derived types, patterns",
             "xpath": "XPath and when/must evaluation", "validation": "data validation", "codecs": "JSON/XML data parsing and printing",
             "diff": "data diff and merge", "infra": "CI, build, tooling, scripts", "docs": "documentation only"},
    "size": {"S": "under 100 lines of Go", "M": "100 to 500 lines of Go", "L": "more than 500 lines of Go, should be split"},
    "worker": {"opus": "hard design or cross-cutting work", "sonnet": "mechanical port of one C file",
               "codex-sol": "independent fixtures and tests", "codex-luna": "small focused fixes and refactors"},
}


def ask(state, questions):
    """Return Jev's answers dict, or None on any failure."""
    key = os.environ.get("TYPESAFE_API_KEY")
    if not re.fullmatch(r"[A-Za-z0-9._-]+", key or ""):  # also keeps the curl config line intact
        return None
    body = json.dumps({"model": "jev-latest", "state": state, "questions": questions})
    cfg = 'header = "Authorization: Bearer %s"\n' % key  # via stdin: not in argv
    try:
        r = subprocess.run(["curl", "-fsS", "--max-time", "20", "-K", "-", API, "-H", "Content-Type: application/json", "-d", body],
                           input=cfg, capture_output=True, text=True, timeout=30)
        a = json.loads(r.stdout)["answers"]
        return a if r.returncode == 0 and isinstance(a, dict) else None
    except (subprocess.SubprocessError, OSError, ValueError, KeyError, TypeError):
        return None


def num(x):
    return float(x) if isinstance(x, (int, float)) and not isinstance(x, bool) else None


def port_map(path):
    """{libyang file basename: set of C functions} for rows not marked skipped."""
    m = {}
    try:
        for ln in open(path, encoding="utf-8"):
            c = [x.strip().strip("`") for x in ln.strip().strip("|").split("|")]
            if len(c) >= 4 and c[0].endswith(".c") and c[3].lower() != "skipped":
                m.setdefault(os.path.basename(c[0]), set()).add(c[1])
    except OSError:
        pass
    return m


def touches(pm, files, funcs):
    base = {os.path.basename(f) for f in files if f.startswith("src/")}
    hit = base & pm.keys()
    if not hit:
        return "no"
    known = set().union(*(pm[f] for f in hit))
    return "function" if funcs and known & set(funcs) else "file"


def drift(commits):
    pm = port_map(os.environ.get("PORT_MAP", os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "docs", "port-map.md")))
    qs = {"behaviour": {"type": "noul", "instructions": "Judging only from the commit subject and the touched paths of this upstream YANG library commit: does it change observable behaviour (validation results, diagnostics, printed output, accepted input) rather than being a refactor, test, build or documentation change?"},
          "priority": {"type": "score", "instructions": "How urgently should a pure-Go port of this library mirror this upstream commit? Judge only from the subject and touched paths.",
                       "criteria": ["later: refactor, tests, docs or build only", "next milestone: behaviour change in a less central area", "now: user-visible bug fix or behaviour change in core parsing, validation or XPath"]}}
    rows, answered, fails, t0 = [], False, 0, time.monotonic()
    for c in commits:
        try:
            files = [f for f in c.get("files", []) if isinstance(f, str)]
            t = touches(pm, files, c.get("functions", []))
            line = f"- [`{str(c.get('sha', ''))[:7]}`]({c.get('url', '')}) {c.get('subject', '')}"
            b = pr = None
            if fails < MAX_FAILS and time.monotonic() - t0 < BUDGET:
                a = ask({"subject": str(c.get("subject", ""))[:300], "paths": files[:50]}, qs)
                try:
                    b, pr = num(a["behaviour"]["noul"]), num(a["priority"]["score"])
                except (KeyError, TypeError):
                    pass
                fails = 0 if b is not None and pr is not None else fails + 1
            if b is not None and pr is not None:
                answered = True
                lvl = "now" if pr >= 1.5 else "next-milestone" if pr >= 0.5 else "later"
                line += f" — behaviour: {'yes' if b >= 0.5 else 'no'} ({b:.0%}) · touches_ported: {t} · priority: {lvl}"
            rows.append((-(pr if pr is not None else -1), line))
        except Exception as e:  # one bad row never costs the list
            print(f"jev-triage: skipped a row: {e}", file=sys.stderr)
    if answered:
        rows.sort(key=lambda r: r[0])  # stable: ties keep upstream order
    print("\n".join(r[1] for r in rows))


def issue(n):
    if not re.fullmatch(r"[0-9]+", n):
        return
    repo = os.environ.get("GH_REPO", "")
    gh = lambda *a: subprocess.run(["gh", *a], capture_output=True, text=True, timeout=60)
    r = gh("api", f"repos/{repo}/issues/{n}")
    try:
        i = json.loads(r.stdout)
        if r.returncode or str(i["user"]["id"]) != os.environ.get("MAINTAINER_ID", "1056050"):
            return
        title, body = str(i["title"])[:300], (i.get("body") or "").encode()[:BODY_MAX].decode(errors="ignore")
    except Exception:
        return
    qs = {k: {"type": "choice", "instructions": f"Pick the {k} for this GitHub issue of a pure-Go port of the libyang YANG library.", "criteria": v} for k, v in CHOICES.items()}
    a = ask({"title": title, "body": body}, qs)
    labels, low = [], False
    try:
        for k, opts in CHOICES.items():
            p = a[k]["probabilities"]
            if not all(num(p[o]) is not None for o in opts):
                return
            top = max(opts, key=lambda o: p[o])
            if p[top] >= MIN:
                labels.append(f"{k}:{top}")
            else:
                low = True
    except Exception:
        return
    if low:
        labels.append("triage:needs-human")
    for lb in labels:
        gh("label", "create", lb, "--color", "C5DEF5", "-R", repo)  # fails if it exists: never recoloured
    if labels:
        gh("issue", "edit", n, "--add-label", ",".join(labels), "-R", repo)


def main(argv):
    try:
        if len(argv) == 3 and argv[1] == "drift":
            drift(json.load(sys.stdin if argv[2] == "-" else open(argv[2])))
        elif len(argv) == 3 and argv[1] == "issue":
            issue(argv[2])
        else:
            sys.exit("usage: jev-triage drift <commits.json|-> | issue <number>")
    except (OSError, ValueError, AttributeError, TypeError, subprocess.SubprocessError) as e:
        print(f"jev-triage: {e}", file=sys.stderr)  # advisory: never fail the job


main(sys.argv)
