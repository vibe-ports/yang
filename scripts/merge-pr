#!/usr/bin/env bash
# Merge gate + fast-forward merge (never the GitHub merge button: it records the local time zone).
# Run the TRUSTED copy from main, never a PR's version, in a checkout of origin/main:
#   git fetch origin main && git switch --detach origin/main
#   scripts/merge-pr <pr-number>        (refuses unless identical to origin/main:scripts/merge-pr)
#   bash <(git show origin/main:scripts/merge-pr) <pr-number>      (same, without the file)
# Merges only if, for the PR's current FULL head SHA:
#  - the PR is open, not a draft, targets main of this repository (origin);
#  - review: the LATEST canonical attestation line naming that SHA — in a never-edited PR comment
#    (a "changes" line counts even in an edited one, dated by the edit)
#    authored by the maintainer (numeric id MAINTAINER_ID, default 1056050), outside code fences —
#    is   VERDICT: approve <40-hex head sha> (<reviewer>)   with reviewer codex-* or port-reviewer-*
#    (not claude-*: that is the ai-review bot's signature, and a pasted bot line must not count)
#    (scripts/astra emits it; a later "VERDICT: changes <sha> …" revokes an earlier approve);
#    or, when no attestation names the head, the PR's newest attestation approves an older head A
#    (a force-pushed-away head of this PR) and the head is a patch-identical rebase of A: same
#    commits in order with identical patches, messages, authors and author dates, and replaying A
#    onto the new base gives exactly the head's trees ("approval of A carried over" is logged);
#  - CI: every (non-cancelled) run of .github/workflows/ci.yml for exactly that SHA succeeded;
#  - every branch commit has +0000 author/committer dates and the head fast-forwards main.
# Then pushes <head>:main with a lease on the main SHA it checked; GitHub marks the PR merged.
# Limits: an advisory gate, not branch protection (Free private plan: anyone with write access can
# push to main directly); a PR can change ci.yml itself, so policy-file changes need human review.
set -euo pipefail
fail() { echo "merge-pr: $*" >&2; exit 1; }
pr=${1:?usage: scripts/merge-pr <pr-number>}
[[ $pr =~ ^[1-9][0-9]*$ ]] || fail "bad PR number"
cd "$(git rev-parse --show-toplevel)"
expected_repo=vibe-ports/yang
maintainer=${MAINTAINER_ID:-1056050}
[[ $maintainer =~ ^[0-9]+$ ]] || fail "bad MAINTAINER_ID"

repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
[[ $repo == "$expected_repo" ]] || fail "gh resolves to '$repo', expected $expected_repo"
url=$(git remote get-url origin)
[[ $url =~ github\.com[:/]${expected_repo}(\.git)?$ ]] || fail "origin is not $expected_repo"

# Trusted code only: this script, the hooks the push runs and everything else in the checkout
# must be main's. (Run as a file it must equal main's copy; via `bash <(git show …)` it is.)
git fetch -q origin "+refs/heads/main:refs/remotes/origin/main"
base=$(git rev-parse refs/remotes/origin/main)
if [[ -f ${BASH_SOURCE[0]} ]]; then
  git show "$base:scripts/merge-pr" | cmp -s - "${BASH_SOURCE[0]}" ||
    fail "this merge-pr differs from origin/main's; run: bash <(git show origin/main:scripts/merge-pr) $pr"
fi
[[ $(git rev-parse HEAD) == "$base" ]] ||
  fail "checkout HEAD is not origin/main ($base): git switch --detach origin/main"
git diff --quiet HEAD -- scripts .githooks || fail "local changes under scripts/ or .githooks/"

pr_state() { gh api "repos/$repo/pulls/$pr" --jq '[.state, .draft, .base.ref, .base.repo.full_name, .head.sha] | @tsv'; }
IFS=$'\t' read -r state draft base_ref base_repo head < <(pr_state)
[[ $state == open && $draft == false ]] || fail "PR is $state (draft=$draft)"
[[ $base_ref == main && $base_repo == "$repo" ]] || fail "PR targets $base_repo:$base_ref, not $repo:main"
[[ $head =~ ^[0-9a-f]{40}$ ]] || fail "bad head SHA"
short=${head:0:7}

verdict=$(gh api --paginate --slurp "repos/$repo/issues/$pr/comments" | jq -r --argjson uid "$maintainer" --arg sha "$head" '
  # Lines outside fenced code blocks, per CommonMark: an opening fence is 3+ backticks or tildes
  # (indent <= 3; a backtick fence info string has no backticks); only a fence of the SAME char,
  # at least as long, with nothing after it, closes it. An unclosed fence runs to the end.
  def unfenced: reduce (split("\n")[] | rtrimstr("\r")) as $l ({f: null, out: []};
    if .f == null then
      (($l | capture("^ {0,3}(?<m>`{3,}|~{3,})(?<rest>.*)$")) // null) as $o
      | if $o != null and ($o.m[0:1] == "~" or ($o.rest | test("`") | not)) then .f = $o.m
        else .out += [$l] end
    else
      (($l | capture("^ {0,3}(?<m>`{3,}|~{3,})[ \t]*$")) // null) as $c
      | if $c != null and $c.m[0:1] == .f[0:1] and ($c.m | length) >= (.f | length) then .f = null
        else . end
    end) | .out[];
  # An edited comment can still revoke (changes), never approve. Order by when the line was last
  # written: a "changes" edited into an old comment must outrank approvals posted before the edit
  # (approvals are never edited, so for them updated_at == created_at). Fail closed on a tie: at
  # the same second a "changes" sorts after every approve, whatever the comment ids.
  [ .[][] | select(.user.id == $uid) | . as $c
    | (.body // "" | unfenced
       | capture("^VERDICT: (?<v>approve|changes) (?<s>[0-9a-f]{40}) \\((codex-[A-Za-z0-9_.-]+|port-reviewer-[A-Za-z0-9_.-]+)\\)$"))
    | select(.v == "changes" or $c.updated_at == $c.created_at)
    | {t: $c.updated_at, id: $c.id, v, s} ]
  | sort_by([.t, .v == "changes", .id]) | (map(select(.s == $sha)) | last | .v // "none") as $h | (last // {v: "none", s: "-"})
  | "\($h) \(.v) \(.s)"')
read -r verdict last_v last_s <<<"$verdict"
# No attestation for the head itself: the PR's newest attestation (any SHA) may approve an older
# head A, which carries over if the head is a patch-identical rebase of A (checked below).
carried=
[[ $verdict == none && $last_v == approve ]] && carried=$last_s
[[ $verdict == approve || -n $carried ]] ||
  fail "latest maintainer attestation for $head is '$verdict', need 'VERDICT: approve $head (codex-…)' (newest attestation of the PR: $last_v $last_s)"

# A head SHA can have several ci.yml runs (push + pull_request, reopen); each run reports its
# latest attempt. Every run must have succeeded; runs cancelled by a newer one don't count, but at
# least one success is required.
ci=$(gh api "repos/$repo/actions/workflows/ci.yml/runs?head_sha=$head&per_page=100" | jq -r --arg sha "$head" --arg repo "$repo" '
  [ .workflow_runs[] | select(.path == ".github/workflows/ci.yml" and .head_sha == $sha and .repository.full_name == $repo)
    | select(.conclusion != "cancelled") | "\(.status)/\(.conclusion)" ]
  | unique | if length == 0 then "missing" else join(",") end')
[[ $ci == completed/success ]] || fail "ci.yml runs on $short are '$ci', need completed/success"

git fetch -q origin "refs/pull/$pr/head"
[[ $(git rev-parse FETCH_HEAD) == "$head" ]] || fail "fetched PR head differs from $head (PR moved?)"
git merge-base --is-ancestor "$base" "$head" || fail "$short does not fast-forward main: rebase (UTC dates) and re-review"
bad=$(git log --format='%h %ad %cd' --date=format:%z "$base..$head" | awk '$2!="+0000" || $3!="+0000"')
[[ -z $bad ]] || fail "commits with non-UTC dates:"$'\n'"$bad"

if [[ -n $carried ]]; then
  A=$carried
  nope() { fail "approval of $A does not carry over to $head: $*"; }
  # A was a head of THIS PR: GitHub's record of force pushes to the PR branch (GraphQL; the REST
  # timeline gives only the new SHA of a force push, not the replaced one).
  heads=$(gh api graphql --paginate -F owner="${repo%/*}" -F name="${repo#*/}" -F pr="$pr" -f query='
    query($owner: String!, $name: String!, $pr: Int!, $endCursor: String) {
      repository(owner: $owner, name: $name) { pullRequest(number: $pr) {
        timelineItems(first: 100, after: $endCursor, itemTypes: [HEAD_REF_FORCE_PUSHED_EVENT]) {
          pageInfo { hasNextPage endCursor }
          nodes { ... on HeadRefForcePushedEvent { beforeCommit { oid } afterCommit { oid } } } } } } }' \
    --jq '.data.repository.pullRequest.timelineItems.nodes[] | (.beforeCommit.oid, .afterCommit.oid) | values') ||
    nope "cannot read the PR's force-push history"
  grep -qxF "$A" <<<"$heads" || nope "it was never a head of PR #$pr"
  git fetch -q origin "$A" && [[ $(git rev-parse FETCH_HEAD) == "$A" ]] || nope "cannot fetch it"
  # merge-tree honours the checkout's attribute files (merge drivers, eol): only main's may apply.
  [[ -z $(git status --porcelain --ignored -- ':(glob)**/.gitattributes') && -z $(git status --porcelain) &&
    ! -s $(git rev-parse --git-path info/attributes) ]] ||
    nope "the checkout is not clean (git status, .gitattributes, \$GIT_DIR/info/attributes)"
  # Same commits in the same order, each with an identical patch (--verbatim: whitespace counts),
  # message and author. patch-id ignores line numbers, so replaying A's commits onto H's base with
  # git's own merge must also give H's trees exactly: no hunk lands elsewhere, no binary change
  # hides behind "Binary files differ", no conflict resolution is carried over.
  commits() { # <merge base> <commits oldest first>; fails on merge commits
    local mb l m; mb=$(git merge-base "$base" "$1") && l=$(git rev-list --reverse "$mb..$1") &&
      m=$(git rev-list --merges "$mb..$1") && [[ -z $m ]] && echo "$mb" $l
  }
  ident() { # --verbatim = --stable without stripping whitespace (git rejects both together)
    local p; p=$(git diff-tree -p --binary "$1^" "$1" | git patch-id --verbatim) || return 1
    echo "$p"; git log -1 --format='%an <%ae> %ad%n%B' --date=raw "$1"
  }
  la=($(commits "$A")) && lh=($(commits "$head")) || nope "no merge base, or merge commits"
  ((${#la[@]} == ${#lh[@]} && ${#la[@]} > 1)) || nope "commit count differs"
  for ((i = 1; i < ${#la[@]}; i++)); do
    ia=$(ident "${la[i]}") && ih=$(ident "${lh[i]}") || nope "cannot read commit $i"
    [[ $ia == "$ih" ]] || nope "commit $i differs (patch, message or author)"
    tree=$(git merge-tree --write-tree --merge-base="${la[i]}^" "${lh[i - 1]}" "${la[i]}") ||
      nope "commit $i does not replay cleanly"
    [[ $tree == "$(git rev-parse "${lh[i]}^{tree}")" ]] || nope "commit $i is not a pure rebase"
  done
fi

# Narrow the API race: the PR must still be open at the same head right before pushing.
IFS=$'\t' read -r state draft _ _ head2 < <(pr_state)
[[ $state == open && $draft == false && $head2 == "$head" ]] || fail "PR changed while checking (head $head2)"

git push --force-with-lease="refs/heads/main:$base" origin "$head:refs/heads/main" ||
  fail "push rejected (main moved since $base?)"
git fetch -q origin "+refs/heads/main:refs/remotes/origin/main"
[[ -z $carried ]] || echo "approval of $carried carried over: patch-identical rebase"
echo "merged #$pr as $head"
