#!/usr/bin/env bash
# Fails if the repo would expose private details: infrastructure, personal data, employer names,
# local paths. Generic rules live here; personal/infra names live ONLY on the maintainer's machine
# (never in the repo, never in CI):
#   denylist   ${SENSITIVE_DENYLIST:-$HOME/.config/vibe-ports/denylist}  one Perl regex per line
#   allowlist  <same directory>/allowlist   exceptions to personal rules: Perl regexes matched
#              against "<where>\t<line>" (where = path:line, commit:path, commit:message,
#              commit:author, commit:committer or tag:tag)
# Usage: scripts/check-sensitive [--staged | --all | --history | --range <revs>... | --tag <obj>...]
#   --staged  index entries about to be committed (pre-commit hook)   --all  every tracked file
#   --history every commit and annotated tag    --range  given commits (git log revs, pre-push)
#   --tag     given annotated tag objects (pre-push)
# Scans file contents from git objects (symlinks are not followed), file names, and in
# --history/--range also commit messages and author/committer identities. Case-insensitive.
# A line containing "sensitive:allow" is exempt from the GENERIC rules only; personal rules can
# be waived only via the allowlist, so committed text can't switch them off.
# If the denylist exists but is unreadable, empty or has an invalid regex: fail (exit 2). A
# missing denylist also fails when `git config vibe.requireDenylist` is true (maintainer clones).
# Patterns are never printed; matched text neither, except that a file-name hit names the file.
# Perl, not grep: regex dialects differ by platform.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
mode=${1:---staged}; [[ $# -gt 0 ]] && shift

# Generic rules (safe to publish). The macOS home prefix /Users is matched case-sensitively, so a
# lowercase "users" node in YANG data paths ("grup/users/name", issue #59) is not a hit. /home/dev (container user) and /home/runner (GitHub runners) are allowed.
generic=$(printf '%s\n' \
  '(?-i:/Users)/[\w.-]+' \
  '/home/(?!dev\b|runner\b)[a-z][\w-]*' \
  '/private/tmp/|/var/folders/') # sensitive:allow (rule definitions)

denylist=${SENSITIVE_DENYLIST:-$HOME/.config/vibe-ports/denylist}
allowlist=$(dirname "$denylist")/allowlist
read_list() { # prints the file; absent → nothing; present but unusable → exit 2
  [[ -e $1 || -L $1 ]] || return 0
  [[ -f $1 && -r $1 ]] || { echo "check-sensitive: $1 exists but is not a readable file" >&2; exit 2; }
  cat -- "$1"
}
personal=$(read_list "$denylist")
allow=$(read_list "$allowlist")
if [[ -e $denylist ]]; then
  grep -qv '^[[:space:]]*\(#.*\)\{0,1\}$' <<<"$personal" ||
    { echo "check-sensitive: $denylist has no patterns" >&2; exit 2; }
elif [[ $(git config --type=bool --get vibe.requireDenylist || true) == true ]]; then
  echo "check-sensitive: vibe.requireDenylist is set but $denylist is missing" >&2; exit 2
else
  echo "check-sensitive: no personal denylist ($denylist) - generic rules only" >&2
fi
export CS_GENERIC=$generic CS_PERSONAL=$personal CS_ALLOW=$allow

# Reads "<where>\t<text>" lines, prints "<where>" for each hit (the matched text is not printed).
scan() {
  LC_ALL=C perl -ne '
    BEGIN {
      $SIG{__WARN__} = sub {};  # perl warnings can quote a pattern
      sub load { my ($set) = @_; my ($n, @r) = (0);
        for (split /\n/, $ENV{$set} // "") { $n++; next if !/\S/ || /^\s*#/;
          my $re = eval { qr/$_/i };
          unless (defined $re) { print STDERR "check-sensitive: invalid regex on line $n of $set (not shown)\n"; exit 2 }
          push @r, $re }
        @r }
      @g = load("CS_GENERIC"); @p = load("CS_PERSONAL"); @a = load("CS_ALLOW");
    }
    chomp; my ($where, $t) = split /\t/, $_, 2; next unless defined $t;
    my $hit = $t !~ /sensitive:allow/ && grep { $t =~ $_ } @g;
    if (!$hit && grep { $t =~ $_ } @p) { my $s = "$where\t$t"; $hit = !grep { $s =~ $_ } @a }
    print "$where\n" if $hit;'
}

# Identities, messages and added lines/paths of every commit in "$@" (git log revision arguments).
commits() {
  git log "$@" -z --format='%h%x09%an <%ae>%x09%cn <%ce>%x09%B' |
    LC_ALL=C perl -0 -ne 'chomp; my ($c, $a, $m, $b) = split /\t/, $_, 4;
      print "$c:author\t$a\n$c:committer\t$m\n"; print "$c:message\t$_\n" for split /\n/, $b // ""'
  # Every path each commit touches, NUL-delimited and independent of patch hunks (an empty file
  # has none). Records: "\x01<commit>" then "\n<path>", "<path>", …
  git log "$@" -z --name-only --no-renames --diff-merges=first-parent --format='%x01%h' |
    LC_ALL=C perl -0 -ne 'chomp; if (s/^\x01//) { $c = $_; next } s/^\n//; s/[\t\n]/ /g; print "$c:$_ (path)\t$_\n" if length'
  git -c core.quotePath=false log "$@" -p --text --diff-merges=first-parent --no-color --no-ext-diff --format='commit %h' |
    LC_ALL=C perl -ne '
      if (/^commit (\w+)$/) { $c = $1; next }
      if (/^diff --git /) { $h = 1; next }
      if ($h) { if (/^@@/) { $h = 0 } elsif (/^(?:\+\+\+ b\/|--- a\/|rename to |copy to )(.*)/) { $f = $1 } next }
      print "$c:$f\t$1\n" if /^\+(.*)/'
}

# Tagger line and message of annotated tag objects.
tags() {
  for o in "$@"; do
    git cat-file tag "$o" | CS_TAG=${o:0:12} LC_ALL=C perl -ne 'print "$ENV{CS_TAG}:tag\t$_"'
  done
}

case $mode in
  --staged | --all)
    # NUL-delimited names; contents come from the index (git objects), so symlinks aren't followed.
    if [[ $mode == --staged ]]; then list=(git diff --cached --name-only -z --diff-filter=ACMR); else list=(git ls-files -z); fi
    hits=$("${list[@]}" | while IFS= read -r -d '' f; do
      n=${f//[$'\t\n']/ }; printf '%s (path)\t%s\n' "$n" "$n"
      git cat-file blob ":$f" 2>/dev/null | CS_FILE=$n LC_ALL=C perl -ne 'print "$ENV{CS_FILE}:$.\t$_"' || true
    done | scan | sort -u) ;;
  --history)
    tagobjs=$(git for-each-ref refs/tags --format='%(objecttype) %(objectname)' | awk '$1 == "tag" {print $2}')
    # shellcheck disable=SC2086 # hex object names, split on purpose
    hits=$( { commits --all; tags $tagobjs; } | scan | sort -u) ;;
  --range)
    [[ $# -gt 0 ]] || { echo "usage: $0 --range <revs>..." >&2; exit 2; }
    hits=$(commits "$@" | scan | sort -u) ;;
  --tag)
    [[ $# -gt 0 ]] || { echo "usage: $0 --tag <tag object>..." >&2; exit 2; }
    hits=$(tags "$@" | scan | sort -u) ;;
  *) echo "usage: $0 [--staged|--all|--history|--range <revs>...|--tag <obj>...]" >&2; exit 2 ;;
esac

if [[ -n $hits ]]; then
  echo "check-sensitive: possible private data at (matched text not repeated):" >&2
  echo "$hits" >&2
  echo "Remove or generalise it (history: rewrite before pushing/publishing). False positive: generic rule →" >&2
  echo "'sensitive:allow' on the line; personal rule → a regex in $allowlist." >&2
  exit 1
fi
