#!/usr/bin/env bash
# Independent review by codex (default gpt-6-astra) with structured JSON output.
#   scripts/astra review [BASE]      review BASE...HEAD (default origin/main)
#   scripts/astra design FILE...     critique a design note / task plan before implementation
# Env: ASTRA_MODEL (gpt-6-astra), ASTRA_EFFORT (xhigh), ASTRA_PR (PR number → post as comment).
# Exit 1 if any high finding or verdict "changes" — usable as a gate.
# `review` ends with the canonical attestation scripts/merge-pr checks (posted under the
# maintainer's gh identity):  VERDICT: <approve|changes> <full HEAD sha> (codex-<model>)
# That verdict is computed here from the validated JSON, never copied from model text.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
cmd=${1:?usage: scripts/astra review [BASE] | design FILE...}; shift
model=${ASTRA_MODEL:-gpt-6-astra}
out=$(mktemp); trap 'rm -f "$out" "$out.log"' EXIT
sha=$(git rev-parse HEAD)

rules="Follow AGENTS.md (goals: no cgo, libyang v5.8.6 compatibility, auditability). Check behaviour
against libyang v5.8.6 source where relevant (clone of tag v5.8.6 in .cache/libyang if present).
Report only real problems; no style nits unless they hide a bug. Be terse."
case $cmd in
  review)
    base=${1:-origin/main}
    prompt="Review the change set \`git diff $base...HEAD\` (commit $sha) of this repo as an adversarial
reviewer. $rules Focus: correctness vs libyang/RFC, missing oracle fixtures for changed behaviour,
provenance headers + docs/port-map.md rows, API surface, error handling, concurrency, private data." ;;
  design)
    [[ $# -gt 0 ]] || { echo "design needs files" >&2; exit 2; }
    prompt="Critique this design/task plan before implementation: $*. $rules Focus: wrong RFC/libyang
assumptions, missing cases, simpler alternatives, what fixtures would prove it." ;;
  *) echo "unknown command $cmd" >&2; exit 2 ;;
esac

codex exec -m "$model" -c model_reasoning_effort="${ASTRA_EFFORT:-xhigh}" -s read-only --ephemeral \
  --output-schema scripts/review-schema.json -o "$out" "$prompt" </dev/null >"$out.log" 2>&1 ||
  { echo "codex failed:" >&2; tail -20 "$out.log" >&2; exit 2; }

report=$(python3 - "$out" "$model" "$sha" "$cmd" <<'PY'
import json, re, sys
r = json.load(open(sys.argv[1])); model, sha, cmd = sys.argv[2:5]
if r.get("verdict") not in ("approve", "changes") or not isinstance(r.get("findings"), list):
    sys.exit("invalid codex answer")
n = lambda s: re.sub(r"(?im)^(\s*)VERDICT\s*:", r"\1verdict -", str(s))  # no forged attestations
bad = r["verdict"] != "approve" or any(f["severity"] == "high" for f in r["findings"])
verdict = "changes" if bad else "approve"
print(f"### {model} {cmd} of `{sha}`: **{verdict}**\n\n{n(r['summary'])}\n")
for f in r["findings"]:
    print(f"- **{f['severity']}** `{n(f['file'])}:{f['line']}` — {n(f['problem'])} → {n(f['fix'])}")
if cmd == "review":
    print(f"\nVERDICT: {verdict} {sha} (codex-{model})")
sys.exit(1 if bad else 0)
PY
) && rc=0 || rc=$?
echo "$report"
[[ -n ${ASTRA_PR:-} ]] && gh pr comment "$ASTRA_PR" --body "$report" >/dev/null
exit $rc
