#!/usr/bin/env bash
# Prints "deep" or "light": which model reviews a PR.
#   scripts/review-tier < files.json      files.json = [{"path":…,"additions":N,"deletions":N}, …]
# Input is file paths and line counts only (no title, body or code), so ai-review can run it from
# main on PR data without executing anything from the PR.
# 1. Free heuristic: size and risky paths → deep.
# 2. Otherwise, if TYPESAFE_API_KEY is set, ask Jev (TypeSafe) whether the PR needs attention,
#    sending the same paths + counts. Jev can only escalate light → deep, never the reverse; any
#    Jev failure keeps the heuristic answer.
set -euo pipefail
files=$(jq -c '[.[] | {path: (.path | tostring), additions: (.additions | tonumber), deletions: (.deletions | tonumber)}]')
lines=$(jq '[.[] | .additions + .deletions] | add // 0' <<<"$files")
# Risky = code paths + policy files (rules, CI, hooks, scripts, dev environment).
risky=$(jq -r '.[].path' <<<"$files" | grep -cE '^(internal/(parser|compile|xpath|types)/|data/|[^/]+\.go$|go\.(mod|sum)$|Dockerfile$|\.github/|\.githooks/|\.claude/|\.devcontainer/|scripts/|conformance/oracle/|LICENSE$|Makefile$|dev$)|(^|/)(AGENTS|CLAUDE)\.md$|(^|/)\.codex/|(^|/)\.agents/' || true)
count=$(jq length <<<"$files")

# The compare API lists at most 300 files: a list that long may be truncated.
if (( lines > 400 || risky > 0 || count >= 300 )); then echo deep; exit 0; fi
if [[ -z ${TYPESAFE_API_KEY:-} ]]; then echo light; exit 0; fi

body=$(jq -n --argjson files "$files" --argjson lines "$lines" '{
  model: "jev-latest",
  state: {pull_request: {changed_lines: $lines, files: $files}, project: "pure-Go port of the libyang YANG library; correctness vs libyang matters most"},
  questions: {deep: {type: "noul",
    instructions: "Judging only from the changed file paths and line counts: does this pull request need a deep expert review (behaviour changes, parsing/validation logic, public API, security, build/release process) rather than a quick check (docs, comments, formatting, test data only)?"}}}')
p=$(curl -fsS --max-time 20 https://api.typesafe.ai/v1/systemone \
  -H @<(printf 'Authorization: Bearer %s\n' "$TYPESAFE_API_KEY") -H 'Content-Type: application/json' -d "$body" \
  | jq -r '.answers.deep.noul // empty' 2>/dev/null || true)
if [[ -n $p ]] && awk -v p="$p" 'BEGIN{exit !(p >= 0.5)}'; then echo deep; else echo light; fi
