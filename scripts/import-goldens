#!/usr/bin/env python3
"""Stage regenerated goldens from an UNTRUSTED tarball (libyang-sync's `pr` job).

  scripts/import-goldens <goldens.tar>

The tarball comes from a job that ran upstream code, so it is treated as hostile data:
  - every member must be a regular file (no symlinks, hardlinks, devices, directories) without
    exec bits, at a path matching conformance/corpus/<group>/golden/<name>.json (no controls,
    "." / "..", including after Unicode compatibility normalization);
  - the archive, member count, individual members and total extracted bytes are bounded and
    checked before any destination is written;
  - raw tar records are pre-scanned with a strict allowlist: regular files, optionally preceded
    by one GNU long-name record capped at 4 KiB; all other record types are forbidden;
  - files are written with mode 0644 into existing, non-symlink directories, then `git add`ed;
  - afterwards the whole index diff (`--no-renames`) may contain only A/M entries on such paths
    with mode 100644 — any rename, deletion, mode change or other path aborts.
Pins (Dockerfile, manifest) are never taken from the artifact; the job writes them itself.
"""
import os
import re
import stat
import subprocess
import sys
import tarfile
import unicodedata

ALLOWED = re.compile(r"conformance/corpus/[^/]+/golden/[^/]+\.json")

# The complete corpus at the time these limits were chosen was a 26,531,840-byte tar containing
# 2,866 files, 24,325,128 extracted bytes and a 2,913,000-byte largest member. These limits leave
# at least 2.7x headroom for every extracted-data measure and 5x for the whole archive.
MAX_ARCHIVE_SIZE = 128 * 1024 * 1024
MAX_MEMBERS = 8192
MAX_MEMBER_SIZE = 8 * 1024 * 1024
MAX_EXTRACTED_SIZE = 64 * 1024 * 1024
MAX_METADATA_SIZE = 4 * 1024
READ_SIZE = 1024 * 1024
TAR_BLOCK_SIZE = 512
ZERO_BLOCK = b"\0" * TAR_BLOCK_SIZE
REGULAR_TYPEFLAGS = (b"\0", b"0")
GNU_LONG_NAME_TYPEFLAG = b"L"
GNU_SPARSE_MARKER = b"GNU.sparse"


def die(msg):
    print(f"::error::import-goldens: {msg}", file=sys.stderr)
    sys.exit(1)


def allowed(path):
    return ALLOWED.fullmatch(path) is not None and not any(p in (".", "..") for p in path.split("/"))


def validate_name(path):
    if any(unicodedata.category(c) == "Cc" for c in path):
        die(f"member {path!r} has a control character in its name")
    if not allowed(path):
        die(f"member {path!r} is not a golden JSON path")
    normalized = unicodedata.normalize("NFKC", path)
    if any(unicodedata.category(c) == "Cc" for c in normalized) or not allowed(normalized):
        die(f"member {path!r} is not a golden JSON path after normalization")


def tar_number(field, name):
    """Decode a tar numeric field without asking tarfile to process the header."""
    if field[0] in (0o200, 0o377):  # GNU base-256 encoding
        number = int.from_bytes(field[1:], "big")
        if field[0] == 0o377:
            number -= 256 ** (len(field) - 1)
        return number
    try:
        return int(field.split(b"\0", 1)[0].strip() or b"0", 8)
    except ValueError:
        die(f"invalid tar {name}")


def validate_tar_header(block):
    stored = tar_number(block[148:156], "header checksum")
    unsigned = 256 + sum(block[:148]) + sum(block[156:])
    signed = 256 + sum(b if b < 128 else b - 256 for b in block[:148])
    signed += sum(b if b < 128 else b - 256 for b in block[156:])
    if stored not in (unsigned, signed):
        die("invalid tar header checksum")


def pre_scan(archive, archive_size):
    """Allow only regular files with optional, bounded GNU long names."""
    archive.seek(0)
    records = 0
    members = []
    long_name_offset = None
    while True:  # MAX_MEMBERS records plus the two end-of-archive blocks at most
        header_offset = archive.tell()
        block = archive.read(TAR_BLOCK_SIZE)
        if len(block) != TAR_BLOCK_SIZE:
            die("archive is missing its end-of-archive blocks")
        if block == ZERO_BLOCK:
            if long_name_offset is not None:
                die("GNU long-name record is not followed by a regular file")
            if archive.read(TAR_BLOCK_SIZE) != ZERO_BLOCK:
                die("archive has an invalid end-of-archive marker")
            archive.seek(0)
            return members

        validate_tar_header(block)
        records += 1
        if records > MAX_MEMBERS:
            die(f"member count exceeds {MAX_MEMBERS}")

        typeflag = block[156:157]
        size = tar_number(block[124:136], "member size")
        if size < 0:
            die("tar member has a negative size")
        if GNU_SPARSE_MARKER in block:
            die("tar header contains a GNU sparse marker")
        if typeflag == GNU_LONG_NAME_TYPEFLAG:
            if long_name_offset is not None:
                die("GNU long-name record is not followed by a regular file")
            if size > MAX_METADATA_SIZE:
                die(f"GNU long-name size {size} exceeds {MAX_METADATA_SIZE} bytes")
            long_name_offset = header_offset
        elif typeflag in REGULAR_TYPEFLAGS:
            # With PAX forbidden, tarfile cannot override this raw size. GNU long-name records
            # change only the name, so the scanner and tarfile must agree on every member boundary.
            member_offset = long_name_offset if long_name_offset is not None else header_offset
            members.append((member_offset, archive.tell(), size))
            long_name_offset = None
        else:
            die(f"tar typeflag {typeflag!r} is not an allowed regular file or GNU long name")

        padded_size = ((size + TAR_BLOCK_SIZE - 1) // TAR_BLOCK_SIZE) * TAR_BLOCK_SIZE
        payload_end = archive.tell() + padded_size
        if payload_end > archive_size:
            die("tar member payload extends beyond the archive")
        archive.seek(payload_end)


def read_member(tar, member):
    source = tar.extractfile(member)
    if source is None:
        die(f"member {member.name!r} cannot be read")
    with source:
        data = bytearray()
        remaining = member.size
        while remaining:
            chunk = source.read(min(READ_SIZE, remaining))
            if not chunk:
                die(f"member {member.name!r} is shorter than its declared size")
            data.extend(chunk)
            remaining -= len(chunk)
        if source.read(1):
            die(f"member {member.name!r} exceeds its declared size")
    return data


def main():
    if len(sys.argv) != 2:
        die("usage: import-goldens <goldens.tar>")
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()
    os.chdir(top)
    staged = []
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as archive:
        archive_stat = os.fstat(archive.fileno())
        if not stat.S_ISREG(archive_stat.st_mode):
            die("archive is not a regular file")
        if archive_stat.st_size > MAX_ARCHIVE_SIZE:
            die(f"archive size {archive_stat.st_size} exceeds {MAX_ARCHIVE_SIZE} bytes")
        scanned_members = pre_scan(archive, archive_stat.st_size)
        with tarfile.open(fileobj=archive, mode="r:") as tar:
            members = []
            extracted_size = 0
            for m in tar:  # validate every limit and member before writing anything
                if len(members) >= MAX_MEMBERS:
                    die(f"member count exceeds {MAX_MEMBERS}")
                if len(members) >= len(scanned_members):
                    die("tar parser found a member missing from the raw scan")
                expected_offset, expected_data_offset, expected_size = scanned_members[len(members)]
                if (m.offset, m.offset_data, m.size) != (expected_offset, expected_data_offset, expected_size):
                    die(f"tar parser disagrees with raw scan for member {m.name!r}")
                members.append(m)
                if m.size < 0 or m.size > MAX_MEMBER_SIZE:
                    die(f"member size {m.size} for {m.name!r} exceeds {MAX_MEMBER_SIZE} bytes")
                if extracted_size + m.size > MAX_EXTRACTED_SIZE:
                    die(f"aggregate extracted size exceeds {MAX_EXTRACTED_SIZE} bytes")
                extracted_size += m.size
                if not m.isreg():
                    die(f"member {m.name!r} is not a regular file")
                validate_name(m.name)
                if m.mode & 0o111:
                    die(f"member {m.name!r} has exec bits")
            if len(members) != len(scanned_members):
                die("raw scan found a member missing from the tar parser")
            for m in members:
                d = os.path.dirname(m.name)
                if os.path.islink(d) or os.path.realpath(d) != os.path.join(os.path.realpath(top), d):
                    die(f"directory of {m.name!r} is missing or redirected")
                if os.path.lexists(m.name) and not (os.path.isfile(m.name) and not os.path.islink(m.name)):
                    die(f"{m.name!r} exists and is not a regular file")
            for m in members:
                data = read_member(tar, m)
                fd = os.open(m.name, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
                with os.fdopen(fd, "wb") as f:
                    f.write(data)
                os.chmod(m.name, 0o644)
                staged.append(m.name)
    if staged:
        subprocess.run(["git", "add", "--", *staged], check=True)
    raw = subprocess.run(["git", "diff", "--cached", "--raw", "-z", "--no-renames"],
                         capture_output=True, check=True).stdout.decode().split("\0")
    for i in range(0, len(raw) - 1, 2):
        meta, path = raw[i], raw[i + 1]
        _, new_mode, _, _, status = meta.lstrip(":").split(" ")
        if status not in ("A", "M") or new_mode != "100644" or not allowed(path):
            die(f"unexpected staged change {status} {new_mode} {path!r}")
    print(f"import-goldens: staged {len(staged)} golden file(s)")


if __name__ == "__main__":
    main()
