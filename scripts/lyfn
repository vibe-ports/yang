#!/usr/bin/env bash
# Print where libyang v5.8.6 defines a function/macro/struct/typedef/enum, and its full body.
# Usage: scripts/lyfn [-n] <C-symbol> [more...]     (-n: location only, no body)
#        scripts/lyfn --callers <fn> [more...]       "file:line caller" lines (cscope; matched by NAME, so
#                                                    same-named statics in different files are not told apart)
#        scripts/lyfn --callees [--all] <fn> [more...]   per definition, "== file:first-last fn ==" then
#                                                    "file:line callee" for call sites inside that range;
#                                                    ALL_CAPS macros and assert are dropped unless --all
# Output of the default mode: "== src/file.c:FIRST-LAST symbol ==" followed by the lines.
# Needs universal-ctags, plus cscope for --callers/--callees (macOS: `brew install universal-ctags cscope`;
# dev container: preinstalled).
# Sources: .cache/libyang (`make libyang-src` runs automatically if absent); LYFN_SRC overrides the dir.
set -euo pipefail
usage() { echo "usage: scripts/lyfn [-n | --callers | --callees [--all]] <C-symbol> [more...]" >&2; exit 2; }
loc_only=0 mode= all=0
while [[ ${1:-} == -* ]]; do
  case $1 in
    -n) loc_only=1 ;;
    --callers) mode=callers ;;
    --callees) mode=callees ;;
    --all) all=1 ;;
    *) usage ;;
  esac
  shift
done
(( $# )) || usage

root=$(cd "$(dirname "$0")/.." && pwd)
src=${LYFN_SRC:-$root/.cache/libyang}
if [[ ! -d $src ]]; then
  [[ -n ${LYFN_SRC:-} ]] && { echo "lyfn: $src not found" >&2; exit 1; }
  make -C "$root" libyang-src >&2
fi

if [[ -n $mode ]]; then
  command -v cscope >/dev/null 2>&1 || { echo "lyfn: cscope not found; macOS: brew install cscope" >&2; exit 1; }
  db=$src/cscope.out
  if [[ ! -f $db || -n $(find "$src/src" -type f -newer "$db" -print -quit) ]]; then
    (cd "$src" && find src -name '*.[ch]' | sort >cscope.files && cscope -b -k -i cscope.files) \
      || { echo "lyfn: cscope build failed" >&2; exit 1; }
  fi
fi

ctags=
if [[ $mode != callers ]]; then
  for c in universal-ctags ctags; do
    if command -v "$c" >/dev/null 2>&1 && "$c" --version 2>/dev/null | grep -q '^Universal Ctags'; then ctags=$c; break; fi
  done
  [[ -n $ctags ]] || { echo "lyfn: universal-ctags not found (BSD/Exuberant ctags will not do); macOS: brew install universal-ctags" >&2; exit 1; }
  tags=$src/tags
  if [[ ! -f $tags || -n $(find "$src/src" -type f -newer "$tags" -print -quit) ]]; then
    out=$(cd "$src" && "$ctags" --options=NONE -R --quiet --fields=+ne --languages=C --langmap=C:.c.h --kinds-C=-m -f tags src 2>&1) \
      || { echo "$out" >&2; exit 1; }
  fi
fi

rc=0
if [[ $mode == callers ]]; then
  for sym in "$@"; do
    out=$(cd "$src" && cscope -d -L -3 "$sym" | awk '{ print $1 ":" $3 " " $2 }' | sort -t: -k1,1 -k2,2n -u)
    [[ -n $out ]] || { echo "lyfn: $sym: none found" >&2; rc=1; continue; }
    echo "$out"
  done
  exit "$rc"
fi

for sym in "$@"; do
  # kind<TAB>file<TAB>first<TAB>last ("-" when ctags gave no end line)
  hits=$(awk -F'\t' -v s="$sym" '$1 == s && $0 !~ /^!/ {
    l = ""; e = "-"
    for (i = 4; i <= NF; i++) { if ($i ~ /^line:/) l = substr($i, 6); if ($i ~ /^end:/) e = substr($i, 5) }
    if (l != "") print $4 "\t" $2 "\t" l "\t" e }' "$tags" | sort -u)
  [[ -n $hits ]] || { echo "lyfn: $sym: not found" >&2; rc=1; continue; }
  found=0
  while IFS=$'\t' read -r kind f first last; do
    [[ $mode == callees && $kind != f ]] && continue
    found=1
    # libyang puts a function's return type on the line above its name
    if [[ $kind == f ]] && (( first > 1 )) && [[ $(sed -n "$((first - 1))p" "$src/$f") =~ ^[A-Za-z_][^\;\}\#/]*$ ]]; then first=$((first - 1)); fi
    if [[ $last == - ]]; then
      # no end line: macro continuation lines, else brace matching (a ';' before any '{' ends it)
      last=$(awk -v n="$first" '
        NR == n && /^[ \t]*#/ { m = 1 }
        NR >= n {
          if (m) { if ($0 !~ /\\$/) { print NR; exit } ; next }
          t = $0; gsub(/"([^"\\]|\\.)*"|\047([^\047\\]|\\.)*\047/, "", t); gsub(/\/\*.*\*\//, "", t); sub(/\/\/.*/, "", t)
          for (i = 1; i <= length(t); i++) { c = substr(t, i, 1)
            if (c == "{") { d++; seen = 1 } else if (c == "}") d--; else if (c == ";" && !seen) { print NR; exit } }
          if (seen && d <= 0) { print NR; exit } }' "$src/$f")
      last=${last:-$first}
    fi
    echo "== $f:$first-$last $sym =="
    if [[ $mode == callees ]]; then
      # cscope scopes by its own parse and can bleed into neighbours: keep only sites in this definition
      (cd "$src" && cscope -d -L -2 "$sym") | awk -v f="$f" -v a="$first" -v b="$last" -v all="$all" '
        $1 == f && $3 >= a && $3 <= b && (all || ($2 !~ /^[A-Z_][A-Z0-9_]*$/ && $2 != "assert")) { print $1 ":" $3 " " $2 }' \
        | sort -t: -k2,2n -u
    elif (( ! loc_only )); then
      sed -n "${first},${last}p" "$src/$f"
    fi
  done <<<"$hits"
  (( found )) || { echo "lyfn: $sym: no function definition found" >&2; rc=1; }
done
exit "$rc"
