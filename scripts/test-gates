#!/usr/bin/env bash
# Self-test of the security gates with stubbed `gh`/`curl` and throwaway git repos (no network, no
# real merges): check-sensitive + pre-push hook, merge-pr, import-goldens, astra --trusted
# (stubbed codex), ai-review-publish, review-tier, jev-triage, check-registries.
#   scripts/test-gates        (part of `make ci`; needs bash, git, perl, python3, jq)
set -uo pipefail
src=$(cd "$(dirname "$0")" && pwd)
t=$(mktemp -d); trap 'chmod -R u+rwx "$t"; rm -rf "$t"' EXIT
fails=0
ok() { echo "ok   $1"; }
no() { echo "FAIL $1"; fails=$((fails + 1)); }
# expect <exit code> <name> <stderr ERE that must match, or -> <cmd...>
expect() {
  local want=$1 name=$2 why=$3; shift 3
  "$@" >"$t/out" 2>"$t/err"; local got=$?
  if [[ $got != "$want" ]]; then no "$name (exit $got, want $want)"; sed 's/^/     /' "$t/err" | head -5
  elif [[ $why != - ]] && ! grep -qE -- "$why" "$t/err"; then no "$name (wrong reason)"; sed 's/^/     /' "$t/err" | head -5
  else ok "$name"; fi
}
has() { if grep -qE -- "$2" "$3"; then ok "$1"; else no "$1"; fi; }
hasnt() { if grep -qE -- "$2" "$3"; then no "$1"; else ok "$1"; fi; }
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com
export GIT_AUTHOR_DATE="1700000000 +0000" GIT_COMMITTER_DATE="1700000000 +0000" GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_NOSYSTEM=1

# ---------------------------------------------------------------- check-sensitive
r=$t/cs; mkdir -p "$r/scripts" "$t/cfg"; git -C "$r" init -q -b main
cp "$src/check-sensitive" "$r/scripts/"
export SENSITIVE_DENYLIST=$t/cfg/denylist
echo 'zorkhost' >"$SENSITIVE_DENYLIST"
cs() { (cd "$r" && scripts/check-sensitive "$@"); }
HIT='possible private data'
git -C "$r" add scripts && git -C "$r" commit -qm init
echo 'clean' >"$r/a.txt"; git -C "$r" add a.txt
expect 0 "cs: clean staged" - cs --staged
echo 'on zorkhost # sensitive:allow' >"$r/a.txt"; git -C "$r" add a.txt
expect 1 "cs: inline marker does not waive a personal rule" "^a\.txt:1$" cs --staged
hasnt "cs: matched text not printed" zorkhost "$t/err"
printf '^a\\.txt:1\\t\n' >"$t/cfg/allowlist"
expect 0 "cs: external allowlist waives a personal rule" - cs --staged
rm "$t/cfg/allowlist"
echo 'see /Users/someone # sensitive:allow' >"$r/a.txt"; git -C "$r" add a.txt
expect 0 "cs: inline marker waives a generic rule" - cs --staged
echo 'see /Us''ers/someone' >"$r/a.txt"; git -C "$r" add a.txt  # split so this file stays clean
expect 1 "cs: generic rule" "^a\.txt:1$" cs --staged
echo clean >"$r/a.txt"; echo zorkhost >"$t/outside"; ln -s ../outside "$r/link"; git -C "$r" add a.txt link
expect 0 "cs: symlink target is not followed" - cs --all
git -C "$r" rm -q --cached link; rm "$r/link"
touch "$r/zorkhost.txt"; git -C "$r" add zorkhost.txt
expect 1 "cs: file name" "zorkhost.txt \(path\)" cs --staged
git -C "$r" rm -q --cached zorkhost.txt; rm "$r/zorkhost.txt"
git -C "$r" commit -qm "fix for zorkhost"
expect 1 "cs: commit message in --history" ":message$" cs --history
expect 1 "cs: commit message in --range" ":message$" cs --range HEAD~1..HEAD
git -C "$r" commit -q --amend -m "fix"
GIT_AUTHOR_NAME=zorkhost git -C "$r" commit -q --allow-empty -m "empty"
expect 1 "cs: author identity in --range" ":author$" cs --range HEAD~1..HEAD
git -C "$r" commit -q --amend --allow-empty --reset-author -m "empty"
echo 'zorkhost' >"$r/b.txt"; git -C "$r" add b.txt; git -C "$r" commit -qm add
git -C "$r" rm -q b.txt; git -C "$r" commit -qm remove
expect 0 "cs: removing a hit is pushable" - cs --range HEAD~1..HEAD
expect 1 "cs: added line in --range" "b\.txt$" cs --range HEAD~2..HEAD
git -C "$r" reset -q --hard HEAD~2
git -C "$r" tag -a v0 -m "release for zorkhost"
expect 1 "cs: annotated tag message (--tag)" ":tag$" cs --tag "$(git -C "$r" rev-parse v0)"
expect 1 "cs: annotated tag message (--history)" ":tag$" cs --history
git -C "$r" tag -d v0 >/dev/null
expect 0 "cs: clean history after the fixes" - cs --history
: >"$r/zorkhost-e.txt"; git -C "$r" add zorkhost-e.txt; git -C "$r" commit -qm add
git -C "$r" rm -q zorkhost-e.txt; git -C "$r" commit -qm rm
expect 1 "cs: empty denied-name file added+deleted (--range)" "zorkhost-e\.txt \(path\)$" cs --range HEAD~2..HEAD
expect 1 "cs: empty denied-name file added+deleted (--history)" "zorkhost-e\.txt \(path\)$" cs --history
expect 0 "cs: … but not in the tree (--all)" - cs --all
git -C "$r" reset -q --hard HEAD~2
echo 'zz[unclosed' >"$SENSITIVE_DENYLIST"
expect 2 "cs: invalid regex fails closed" "invalid regex on line 1 of CS_PERSONAL" cs --all
hasnt "cs: pattern not printed on regex error" 'zz\[unclosed' "$t/err"
printf '# only a comment\n\n' >"$SENSITIVE_DENYLIST"
expect 2 "cs: empty denylist fails closed" "has no patterns" cs --all
echo zorkhost >"$SENSITIVE_DENYLIST"; chmod 000 "$SENSITIVE_DENYLIST"
if [[ -r $SENSITIVE_DENYLIST ]]; then ok "cs: unreadable denylist (skipped: running as root)"
else expect 2 "cs: unreadable denylist fails closed" "not a readable file" cs --all; fi
chmod 600 "$SENSITIVE_DENYLIST"
SENSITIVE_DENYLIST=$t/cfg/missing expect 0 "cs: missing denylist → generic only" "generic rules only" cs --history
git -C "$r" config vibe.requireDenylist true
SENSITIVE_DENYLIST=$t/cfg/missing expect 2 "cs: missing denylist fails with vibe.requireDenylist" "requireDenylist" cs --history
git -C "$r" config --unset vibe.requireDenylist
# pre-push hook: stdin "<local ref> <local sha> <remote ref> <remote sha>"
mkdir -p "$r/.githooks"; cp "$src/../.githooks/pre-push" "$r/.githooks/"
git init -q --bare "$t/cs-remote.git"; git -C "$r" remote add origin "$t/cs-remote.git"
git -C "$r" push -q origin HEAD:refs/heads/main
old=$(git -C "$r" rev-parse HEAD); z=0000000000000000000000000000000000000000
git -C "$r" commit -q --allow-empty -m "about zorkhost"; new=$(git -C "$r" rev-parse HEAD)
hook() { (cd "$r" && .githooks/pre-push origin x <<<"$1"); }
expect 1 "pre-push: message of an outgoing commit" ":message$" hook "refs/heads/main $new refs/heads/main $old"
expect 1 "pre-push: new branch scans unpushed commits" ":message$" hook "refs/heads/b $new refs/heads/b $z"
expect 0 "pre-push: already-pushed commits only" - hook "refs/heads/b $old refs/heads/b $z"
expect 0 "pre-push: branch deletion" - hook "(delete) $z refs/heads/b $old"
git -C "$r" tag -a v1 -m "tag for zorkhost" "$old"
expect 1 "pre-push: annotated tag message" ":tag$" hook "refs/tags/v1 $(git -C "$r" rev-parse v1) refs/tags/v1 $z"

# ---------------------------------------------------------------- stubs
mkdir -p "$t/bin" "$t/fx"
cat >"$t/bin/gh" <<'EOF'
#!/usr/bin/env bash
# Stub: logs calls, answers from $FX fixtures; --jq is applied with jq.
echo "$*" >>"$FX/calls"
[[ $1 == repo ]] && { echo vibe-ports/yang; exit 0; }
[[ $1 == label || $1 == issue ]] && exit 0  # jev-triage: only the call log matters
shift  # api
method=GET jqx= input= path= q=
while (($#)); do case $1 in
  -X) method=$2; shift 2 ;; --jq) jqx=$2; shift 2 ;; --input) input=1; shift 2 ;;
  -f) q=$2; shift 2 ;; -H | -F) shift 2 ;; --paginate | --slurp) shift ;; *) path=$1; shift ;; esac; done
[[ -f $FX/fail ]] && { echo "HTTP 500" >&2; exit 1; }
if [[ $path == graphql ]]; then  # --paginate like gh: graphql.json, graphql.2.json, … while hasNextPage
  [[ -f $FX/graphql-fail ]] && { echo "HTTP 502" >&2; exit 1; }
  [[ $q == *'$endCursor'* && $q == *'pageInfo { hasNextPage endCursor }'* ]] || { echo "bad paginated query" >&2; exit 1; }
  p=$FX/graphql.json n=1
  while [[ -f $p ]] || { echo "no fixture $p" >&2; exit 1; }; do
    jq -r "$jqx" "$p"
    [[ $(jq '[.. | .hasNextPage? | select(. == true)] | length' "$p") == 0 ]] && exit 0
    n=$((n + 1)) p=$FX/graphql.$n.json
  done
fi
if [[ $method != GET ]]; then
  n=$(ls "$FX" | grep -c '^req' || true)
  { echo "$method $path"; [[ -n $input ]] && cat; } >"$FX/req$n"; echo '{}'; exit 0
fi
case $path in
  */pulls/*/comments) f=empty ;; */pulls/*/reviews) f=reviews ;;
  */pulls/*) f=pull
    # Lease-race hook: runs on the 2nd PR lookup (merge-pr's re-check before pushing).
    if [[ -x $FX/on_pull2 && $(grep -c '/pulls/[0-9]* --jq' "$FX/calls") == 2 ]]; then "$FX/on_pull2"; fi ;;
  */issues/*/comments) f=comments ;; */issues/[0-9]*) f=issue ;; */actions/*) f=runs ;; *) f=none ;;
esac
[[ -f $FX/$f.json ]] || { echo "no fixture for $path" >&2; exit 1; }
if [[ -n $jqx ]]; then jq -r "$jqx" "$FX/$f.json"; else cat "$FX/$f.json"; fi
EOF
cat >"$t/bin/curl" <<'EOF'
#!/usr/bin/env bash
# Stub for review-tier's Jev call: records the request body, answers $FX/jev.
[[ -t 0 ]] || cat >"$FX/jev-stdin"; printf "%s\n" "$@" >"$FX/jev-argv"
while (($#)); do [[ $1 == -d ]] && { printf '%s' "$2" >"$FX/jev-request"; shift; }; shift; done
n=$(( $(cat "$FX/jevn" 2>/dev/null || echo 0) + 1 )); echo $n >"$FX/jevn"; echo x >"$FX/jev-called"
[[ -f $FX/jev.$n ]] && { cat "$FX/jev.$n"; exit 0; }  # per-call answers when present
[[ -f $FX/jev ]] || exit 7
cat "$FX/jev"
EOF
chmod +x "$t/bin/gh" "$t/bin/curl"
export PATH=$t/bin:$PATH FX=$t/fx
echo '[[]]' >"$FX/empty.json"; echo '[[]]' >"$FX/reviews.json"

# ---------------------------------------------------------------- merge-pr
mkdir -p "$t/github.com/vibe-ports"; bare=$t/github.com/vibe-ports/yang.git
git init -q --bare -b main "$bare"
m=$t/mp; git -C "$t" clone -q "$bare" mp 2>/dev/null; mkdir -p "$m/scripts"; cp "$src/merge-pr" "$m/scripts/"
git -C "$m" add scripts; git -C "$m" commit -qm base; git -C "$m" push -q origin HEAD:main
echo x >"$m/x"; git -C "$m" add x; git -C "$m" commit -qm feat
head=$(git -C "$m" rev-parse HEAD)
git -C "$m" push -q origin HEAD:refs/pull/7/head
onmain() { git -C "$m" fetch -q origin; git -C "$m" checkout -q --detach origin/main; }
pull() { jq -n --arg h "$head" --argjson d "${1:-false}" '{state:"open",draft:$d,base:{ref:"main",repo:{full_name:"vibe-ports/yang"}},head:{sha:$h}}' >"$FX/pull.json"; }
comments() { # comments <uid> <created> <body> [<uid> <created> <body>]...
  local a='[]'
  while (($#)); do
    a=$(jq --argjson u "$1" --arg c "$2" --arg b "$3" '. + [{id: (length + 1), user: {id: $u}, created_at: $c, updated_at: $c, body: $b}]' <<<"$a"); shift 3; done
  jq -n --argjson a "$a" '[$a]' >"$FX/comments.json"
}
edited() { jq --argjson i "${1:--1}" --arg u "${2:-2026-02-01T00:00:00Z}" '.[0][$i].updated_at = $u' "$FX/comments.json" >"$FX/c.tmp" && mv "$FX/c.tmp" "$FX/comments.json"; }
runs() { # runs <conclusion>...   (one ci run per conclusion; RUNPATH overrides the workflow path)
  jq -n --arg h "$head" --arg p "${RUNPATH:-.github/workflows/ci.yml}" '{workflow_runs: [$ARGS.positional[] |
    {path:$p,head_sha:$h,repository:{full_name:"vibe-ports/yang"},created_at:"2026-01-01T00:00:00Z",run_attempt:1,status:"completed",conclusion:.}]}' \
    --args "$@" >"$FX/runs.json"; }
mp() { (cd "$m" && scripts/merge-pr 7); }
mpw() { (cd "$m" && bash <(git show origin/main:scripts/merge-pr) 7); }
A="VERDICT: approve $head (codex-gpt-6-astra)"
D1=2026-01-01T00:00:00Z D2=2026-01-02T00:00:00Z
NOAPP="latest maintainer attestation"
onmain; pull; runs success
comments 999 $D1 "$A"
expect 1 "merge-pr: approval by another user is ignored" "$NOAPP .* is 'none'" mp
comments 1056050 $D1 "$(printf 'review\n> %s' "$A")"
expect 1 "merge-pr: quoted approval is ignored" "$NOAPP" mp
comments 1056050 $D1 "$(printf 'pasted:\n```\n%s\n```' "$A")"
expect 1 "merge-pr: approval inside a code fence is ignored" "$NOAPP" mp
comments 1056050 $D1 "$(printf 'nested:\n````\n```\n%s\n```\n````' "$A")"
expect 1 "merge-pr: approval inside a 4-backtick block holding a 3-backtick line is ignored" "$NOAPP" mp
comments 1056050 $D1 "$(printf 'mixed:\n~~~\n```\n~~\n%s\n```\n~~~' "$A")"
expect 1 "merge-pr: approval inside a tilde block holding backtick lines is ignored" "$NOAPP" mp
comments 1056050 $D1 "$(printf 'unclosed:\n```json\n%s' "$A")"
expect 1 "merge-pr: approval inside an unclosed fence is ignored" "$NOAPP" mp
comments 1056050 $D1 "$(printf '``` x ` y\n%s' "$A")"
runs failure
expect 1 "merge-pr: inline backticks don't open a fence (approval counts, stops at CI)" "are 'completed/failure'" mp
comments 1056050 $D1 "$(printf '````\n```\n````\n%s' "$A")"
expect 1 "merge-pr: approval after a properly closed fence counts (stops at CI)" "are 'completed/failure'" mp
runs success
comments 1056050 $D1 "$A"; edited
expect 1 "merge-pr: edited comment is ignored" "$NOAPP" mp
comments 1056050 $D1 "VERDICT: approve $head (claude-sonnet-5-5)"
expect 1 "merge-pr: reviewer outside codex-*/port-reviewer-* is ignored" "$NOAPP" mp
comments 1056050 $D1 "VERDICT: approve $head (claude-opus-5-5)"
expect 1 "merge-pr: pasted ai-review bot line (claude-opus) is ignored" "$NOAPP .* is 'none'" mp
comments 1056050 $D1 "VERDICT: approve ${head:0:12} (codex-x)"
expect 1 "merge-pr: short SHA is ignored" "$NOAPP" mp
comments 1056050 $D1 "$A" 1056050 $D2 "VERDICT: changes $head (port-reviewer-opus)"
expect 1 "merge-pr: later 'changes' revokes approval" "$NOAPP .* is 'changes'" mp
runs failure
comments 1056050 $D1 "VERDICT: changes $head (codex-x)" 1056050 $D2 "$A"; edited 0
expect 1 "merge-pr: 'changes' edited into an older comment revokes a newer approval" "$NOAPP .* is 'changes'" mp
comments 1056050 $D1 "VERDICT: changes $head (codex-x)" 1056050 $D2 "$A"; edited 0 $D2
expect 1 "merge-pr: 'changes' edited in the same second as a newer approval wins the tie" "$NOAPP .* is 'changes'" mp
comments 1056050 $D1 "VERDICT: approve $head (port-reviewer-opus)"
expect 1 "merge-pr: port-reviewer-* attestation accepted (stops at CI)" "are 'completed/failure'" mp
comments 1056050 $D1 "VERDICT: changes $head (codex-x)" 1056050 $D2 "$(printf 'text\r\n%s\r\n' "$A")"
expect 1 "merge-pr: failed CI" "are 'completed/failure'" mp
runs success failure
expect 1 "merge-pr: one failed run among several fails the gate" "are 'completed/failure,completed/success'" mp
runs cancelled
expect 1 "merge-pr: only cancelled runs = no CI evidence" "are 'missing'" mp
RUNPATH=.github/workflows/other.yml runs success
expect 1 "merge-pr: CI from another workflow is ignored" "are 'missing'" mp
runs success; pull true
expect 1 "merge-pr: draft PR" "draft=true" mp
pull
git -C "$m" checkout -q --detach "$head"
expect 1 "merge-pr: refuses when HEAD is not origin/main" "not origin/main" mp
onmain; echo '# tampered' >>"$m/scripts/merge-pr"
expect 1 "merge-pr: refuses a copy that differs from main's" "differs from origin/main" mp
git -C "$m" checkout -q -- scripts/merge-pr
git -C "$t" clone -q "$bare" racer 2>/dev/null
printf '#!/usr/bin/env bash\ngit -C %q commit -q --allow-empty -m race && git -C %q push -q origin HEAD:refs/heads/main\n' "$t/racer" "$t/racer" >"$FX/on_pull2"
chmod +x "$FX/on_pull2"; : >"$FX/calls"
expect 1 "merge-pr: main moved during the checks → lease rejects the push" "push rejected" mp
rm "$FX/on_pull2"
[[ $(git -C "$bare" rev-parse main) != "$head" ]] && ok "merge-pr: nothing merged by failed gates" || no "merge-pr: merged despite failures"
# main moved (race commit): rebase the PR head onto it, as a real author would.
git -C "$m" fetch -q origin; git -C "$m" checkout -q -b feat2 origin/main
echo x >"$m/x"; git -C "$m" add x; git -C "$m" commit -qm feat; head=$(git -C "$m" rev-parse HEAD)
git -C "$m" push -q -f origin HEAD:refs/pull/7/head
A="VERDICT: approve $head (codex-gpt-6-astra)"; pull; runs success cancelled; comments 1056050 $D1 "$A"
onmain
expect 0 "merge-pr: approved + CI green (+ a cancelled run) merges (trusted wrapper)" - mpw
[[ $(git -C "$bare" rev-parse main) == "$head" ]] && ok "merge-pr: main == reviewed head" || no "merge-pr: main != head"
git -C "$m" checkout -q -b tz "$head"; echo y >"$m/y"; git -C "$m" add y
GIT_COMMITTER_DATE="1700000000 +0200" git -C "$m" commit -qm tz; head=$(git -C "$m" rev-parse HEAD)
git -C "$m" push -q -f origin HEAD:refs/pull/7/head
onmain; pull; runs success; comments 1056050 $D1 "VERDICT: approve $head (codex-gpt-6-astra)"
expect 1 "merge-pr: non-UTC committer date" "non-UTC dates" mp
fake=$(git -C "$m" commit-tree "$head^{tree}" -p "$head^" -m tz); git -C "$m" replace "$head" "$fake"
expect 1 "merge-pr: a replace ref can't hide a non-UTC date" "non-UTC dates" mp
git -C "$m" replace -d "$head" >/dev/null
head=$(git -C "$m" commit-tree "$head^{tree}" -p "$(git -C "$m" rev-parse origin/main~1)" -m side)
git -C "$m" push -q -f origin "$head:refs/pull/7/head"; pull; runs success; comments 1056050 $D1 "VERDICT: approve $head (codex-gpt-6-astra)"
git -C "$m" config advice.graftFileDeprecated false; echo "$head $(git -C "$m" rev-parse origin/main)" >"$m/.git/info/grafts"
expect 1 "merge-pr: a graft can't fake a fast-forward" "does not fast-forward main" mp
rm "$m/.git/info/grafts"

# Approval of an older head A carries over to a patch-identical rebase H. The bare repo serves
# force-pushed-away commits by SHA, like GitHub.
git -C "$bare" config uploadpack.allowAnySHA1InWant true
onmain; git -C "$m" checkout -q -b co origin/main
blk='1\n2\n3\nX\n4\n5\n6\n'  # two identical blocks: same hunk text, different line numbers
printf "$blk$blk" >"$m/f"; git -C "$m" add f; git -C "$m" commit -qm 'feat: f'
echo b >"$m/b"; git -C "$m" add b; git -C "$m" commit -qm 'feat: b'
printf "${blk/X/Y}$blk" >"$m/f"; git -C "$m" commit -qam 'feat: first block'
Aold=$(git -C "$m" rev-parse HEAD); git -C "$m" push -q -f origin HEAD:refs/pull/7/head
git -C "$t/racer" fetch -q origin; git -C "$t/racer" checkout -q --detach origin/main
echo m >"$t/racer/m"; git -C "$t/racer" add m; git -C "$t/racer" commit -qm main2; git -C "$t/racer" push -q origin HEAD:refs/heads/main
forced() { # forced <A> [<other>]: A → H force push on page 1, or on page 2 after <other> → H
  rm -f "$FX"/graphql.*.json
  page() { jq -n --arg b "$1" --arg a "$head" --argjson more "$2" '{data:{repository:{pullRequest:{timelineItems:{
    pageInfo:{hasNextPage:$more,endCursor:"c"},nodes:[{beforeCommit:{oid:$b},afterCommit:{oid:$a}},{beforeCommit:null,afterCommit:null}]}}}}}'; }
  if (($# == 1)); then page "$1" false >"$FX/graphql.json"; else page "$2" true >"$FX/graphql.json"; page "$1" false >"$FX/graphql.2.json"; fi; }
rebased() { git -C "$m" fetch -q origin; git -C "$m" checkout -q --detach "$Aold"; git -C "$m" rebase -q origin/main; }
AA="VERDICT: approve $Aold (codex-gpt-6-astra)"
publish() { # publish [<A>]: H = the checkout's HEAD; A approved, A → H force push recorded, CI green on H
  local a=${1:-$Aold}
  head=$(git -C "$m" rev-parse HEAD); git -C "$m" push -q -f origin HEAD:refs/pull/7/head
  pull; runs success; comments 1056050 $D1 "VERDICT: approve $a (codex-gpt-6-astra)"; forced "$a"; onmain; }
on_main() { # on_main <file> <content>: the racer commits a file straight to main
  git -C "$t/racer" fetch -q origin; git -C "$t/racer" checkout -q --detach origin/main
  printf "$2" >"$t/racer/$1"; git -C "$t/racer" add "$1"; git -C "$t/racer" commit -qm "main: $1"
  git -C "$t/racer" push -q origin HEAD:refs/heads/main; }
NOCO="approval of $Aold does not carry over"
rebased; echo bb >"$m/b"; git -C "$m" commit -qa --amend --no-edit; publish
expect 1 "merge-pr carry-over: a changed patch is refused" "$NOCO.*commit 3 differs" mp
rebased; git -C "$m" checkout -q HEAD~1; echo 'b ' >"$m/b"; git -C "$m" commit -qa --amend --no-edit
git -C "$m" cherry-pick "$Aold" >/dev/null; publish
expect 1 "merge-pr carry-over: a whitespace-only change is refused" "$NOCO.*commit 2 differs" mp
rebased; echo c >"$m/c"; git -C "$m" add c; git -C "$m" commit -qm 'feat: c'; publish
expect 1 "merge-pr carry-over: an added commit is refused" "$NOCO.*commit count differs" mp
rebased; git -C "$m" reset -q --hard HEAD~1; publish
expect 1 "merge-pr carry-over: a removed commit is refused" "$NOCO.*commit count differs" mp
git -C "$m" checkout -q --detach origin/main; git -C "$m" cherry-pick "$Aold~2" "$Aold" "$Aold~1" >/dev/null; publish
expect 1 "merge-pr carry-over: reordered commits are refused" "$NOCO.*commit 2 differs" mp
rebased; git -C "$m" commit -q --amend -m 'feat: first block!'; publish
expect 1 "merge-pr carry-over: a changed message is refused" "$NOCO.*commit 3 differs" mp
rebased; git -C "$m" commit -q --amend --no-edit --author='u <u@example.com>'; publish
expect 1 "merge-pr carry-over: a changed author is refused" "$NOCO.*commit 3 differs" mp
rebased; git -C "$m" commit -q --amend --no-edit --date="1700000001 +0000"; publish
expect 1 "merge-pr carry-over: a changed author date is refused" "$NOCO.*commit 3 differs" mp
rebased; printf "$blk${blk/X/Y}" >"$m/f"; git -C "$m" commit -qa --amend --no-edit; publish
expect 1 "merge-pr carry-over: same patch-id, hunk applied elsewhere is refused" "$NOCO.*commit 3 is not a pure rebase" mp
git -C "$m" checkout -q --detach origin/main; echo s >"$m/s"; git -C "$m" add s; git -C "$m" commit -qm side
side=$(git -C "$m" rev-parse HEAD)
rebased; git -C "$m" merge -q --no-ff -m merge "$side"; publish
expect 1 "merge-pr carry-over: a merge commit in the head's range is refused" "$NOCO.*merge commits" mp
git -C "$m" checkout -q --detach "$Aold"; git -C "$m" merge -q --no-ff -m merge "$side"
Am=$(git -C "$m" rev-parse HEAD); git -C "$m" push -q -f origin HEAD:refs/pull/7/head
rebased; publish "$Am"
expect 1 "merge-pr carry-over: a merge commit in A's range is refused" "approval of $Am does not carry over.*merge commits" mp
rebased; publish "$(git -C "$m" rev-parse origin/main~1)"
expect 1 "merge-pr carry-over: an A already in main is refused" "does not carry over.*commit count differs" mp
nx=0123456789abcdef0123456789abcdef01234567
rebased; publish $nx
expect 1 "merge-pr carry-over: an unfetchable A is refused" "approval of $nx does not carry over.*cannot fetch it" mp
rebased; publish; touch "$FX/graphql-fail"
expect 1 "merge-pr carry-over: GraphQL failure is refused" "$NOCO.*cannot read the PR's force-push history" mp
rm "$FX/graphql-fail"
comments 1056050 $D1 "$AA" 1056050 $D2 "VERDICT: changes $Aold (codex-x)"
expect 1 "merge-pr carry-over: a later 'changes' for A wins (and is named)" "$NOAPP .* is 'none'.*newest attestation of the PR: changes $Aold" mp
comments 1056050 $D1 "$AA" 1056050 $D2 "VERDICT: changes $Aold (codex-x)"; edited
expect 1 "merge-pr carry-over: 'changes' in an edited comment still wins" "newest attestation of the PR: changes $Aold" mp
comments 1056050 $D1 "VERDICT: changes $Aold (codex-x)" 1056050 $D2 "$AA"; edited 0
expect 1 "merge-pr carry-over: 'changes' edited into an older comment revokes a newer approval" "$NOAPP .* is 'none'.*newest attestation of the PR: changes $Aold" mp
comments 1056050 $D1 "VERDICT: changes $Aold (codex-x)" 1056050 $D2 "$AA"; edited 0 $D2
expect 1 "merge-pr carry-over: 'changes' edited in the same second as a newer approval wins the tie" "$NOAPP .* is 'none'.*newest attestation of the PR: changes $Aold" mp
comments 1056050 $D1 "$AA" 1056050 $D2 "VERDICT: changes $(git -C "$m" rev-parse "$Aold~1") (codex-x)"
expect 1 "merge-pr carry-over: a later 'changes' for another head wins" "$NOAPP .* is 'none'" mp
comments 1056050 $D1 "VERDICT: changes $head (codex-x)" 1056050 $D2 "$AA"
expect 1 "merge-pr carry-over: 'changes' on the head itself is not overridden" "$NOAPP .* is 'changes'" mp
comments 1056050 $D1 "$AA"; forced "$(git -C "$m" rev-parse "$Aold~1")"
expect 1 "merge-pr carry-over: A never a head of the PR is refused" "$NOCO .*: it was never a head" mp
forced "$Aold"; runs failure
expect 1 "merge-pr carry-over: CI on the exact head is still required" "are 'completed/failure'" mp
# Conflicting replay: main changes block 1 of g after A did; H applies A's identical hunk to block 2.
on_main g "$blk$blk"; git -C "$m" fetch -q origin; git -C "$m" checkout -q --detach origin/main
printf "${blk/X/Y}$blk" >"$m/g"; git -C "$m" commit -qam 'feat: g'; A2=$(git -C "$m" rev-parse HEAD)
git -C "$m" push -q -f origin HEAD:refs/pull/7/head
on_main g "${blk/X/Z}$blk"; git -C "$m" fetch -q origin; git -C "$m" checkout -q --detach origin/main
printf "${blk/X/Z}${blk/X/Y}" >"$m/g"; git -C "$m" commit -qam 'feat: g'; publish "$A2"
expect 1 "merge-pr carry-over: a replay that conflicts is refused" "approval of $A2 does not carry over.*commit 1 does not replay cleanly" mp
# Local git config and attributes must not reach the replay: a merge driver that writes the
# head's g would turn that conflict into a "pure rebase" of an unreviewed, relocated hunk.
git -C "$m" show "$head:g" >"$t/hg"; CONFL="approval of $A2 does not carry over.*commit 1 does not replay cleanly"
printf '[merge "evil"]\n\tdriver = cat %s >%%A\n' "$t/hg" >"$t/gcfg"; echo 'g merge=evil' >"$t/gattr"
printf '[core]\n\tattributesFile = %s\n' "$t/gattr" >>"$t/gcfg"
GIT_CONFIG_GLOBAL=$t/gcfg expect 1 "merge-pr carry-over: core.attributesFile with a merge driver is ignored" "$CONFL" mp
mkdir -p "$t/xdg/git"; echo 'g merge=evil' >"$t/xdg/git/attributes"; head -2 "$t/gcfg" >"$t/gcfg2"
XDG_CONFIG_HOME=$t/xdg GIT_CONFIG_GLOBAL=$t/gcfg2 expect 1 "merge-pr carry-over: a global gitattributes file is ignored" "$CONFL" mp
git -C "$m" config merge.evil.driver "cat $t/hg >%A"; git -C "$m" config merge.default evil
expect 1 "merge-pr carry-over: a repo-local merge driver (merge.default) is ignored" "$CONFL" mp
git -C "$m" config core.attributesFile "$t/gattr"
expect 1 "merge-pr carry-over: a repo-local core.attributesFile + driver is ignored" "$CONFL" mp
git -C "$m" config --remove-section merge.evil; git -C "$m" config --unset merge.default; git -C "$m" config --unset core.attributesFile
GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=merge.evil.driver GIT_CONFIG_VALUE_0="cat $t/hg >%A" GIT_CONFIG_KEY_1=merge.default \
  GIT_CONFIG_VALUE_1=evil expect 1 "merge-pr carry-over: a merge driver from the environment is ignored" "$CONFL" mp
ia=$m/$(git -C "$m" rev-parse --git-path info/attributes); mkdir -p "${ia%/*}"; echo 'g merge=union' >"$ia"
expect 1 "merge-pr carry-over: \$GIT_DIR/info/attributes merge=union is ignored" "$CONFL" mp
rm "$ia"; echo 'g merge=union' >"$m/.gitattributes"
expect 1 "merge-pr carry-over: an untracked .gitattributes is ignored" "$CONFL" mp
rm "$m/.gitattributes"
rebased; publish; forced "$Aold" "$(git -C "$m" rev-parse "$Aold~1")"
echo 'f merge=union' >"$ia"  # the maintainer's clone has info/attributes: carry-over must still work
expect 0 "merge-pr carry-over: patch-identical rebase merges, A on GraphQL page 2, info/attributes present (trusted wrapper)" - mpw
has "merge-pr carry-over: log names the carried approval" "approval of $Aold carried over: patch-identical rebase" "$t/out"
[[ $(git -C "$bare" rev-parse main) == "$head" ]] && ok "merge-pr carry-over: main == rebased head" || no "merge-pr carry-over: main != head"

# ---------------------------------------------------------------- import-goldens (libyang-sync)
g=$t/ig; G=conformance/corpus/basic/golden; mkdir -p "$g/$G" "$g/scripts"
cp "$src/import-goldens" "$g/scripts/"; echo '{"v":1}' >"$g/$G/a.json"; echo 'FROM x' >"$g/Dockerfile"
git -C "$g" init -q -b main; git -C "$g" add -A; git -C "$g" commit -qm base
mktar() { # mktar <out> <kind:path:arg>...   kind = reg (arg = octal mode) | sym | hard (arg = target)
  python3 - "$@" <<'PY'
import io, sys, tarfile
with tarfile.open(sys.argv[1], "w") as tar:
    for spec in sys.argv[2:]:
        kind, path, arg = spec.split(":", 2)
        ti = tarfile.TarInfo(path)
        if kind == "reg":
            data = b'{"v":2}\n'; ti.size = len(data); ti.mode = int(arg, 8); tar.addfile(ti, io.BytesIO(data))
        else:
            ti.type = tarfile.SYMTYPE if kind == "sym" else tarfile.LNKTYPE; ti.linkname = arg; tar.addfile(ti)
PY
}
ig() { (cd "$g" && scripts/import-goldens "$t/g.tar"); }
igreset() { git -C "$g" reset -q --hard; git -C "$g" clean -fdq; }
mktar "$t/g.tar" "reg:$G/a.json:644" "reg:$G/new.json:644"
expect 0 "import-goldens: modified + new golden" - ig
[[ $(git -C "$g" diff --cached --name-status | tr '\t' ' ' | sort | tr '\n' ,) == "A $G/new.json,M $G/a.json," ]] &&
  ok "import-goldens: exactly the goldens staged" || no "import-goldens: exactly the goldens staged"
igreset; mktar "$t/g.tar" "sym:$G/a.json:../../../../Dockerfile"
expect 1 "import-goldens: symlink member rejected" "not a regular file" ig
igreset; mktar "$t/g.tar" "hard:$G/a.json:Dockerfile"
expect 1 "import-goldens: hardlink member rejected" "not a regular file" ig
igreset; mktar "$t/g.tar" "reg:$G/a.json:755"
expect 1 "import-goldens: executable member rejected" "exec bits" ig
igreset; mktar "$t/g.tar" "reg:conformance/corpus/manifest.yaml:644"
expect 1 "import-goldens: non-golden path rejected" "not a golden JSON path" ig
igreset; mktar "$t/g.tar" "reg:$G/a.json:644" "reg:Dockerfile:644"
expect 1 "import-goldens: Dockerfile tampering rejected" "not a golden JSON path" ig
[[ $(cat "$g/Dockerfile") == "FROM x" && -z $(git -C "$g" diff --cached --name-only) ]] &&
  ok "import-goldens: nothing written when any member is bad" || no "import-goldens: nothing written when any member is bad"
igreset; mktar "$t/g.tar" "reg:conformance/corpus/../golden/x.json:644"
expect 1 "import-goldens: dot-dot path rejected" "not a golden JSON path" ig
igreset; git -C "$g" mv "$G/a.json" "$G/b.json"; mktar "$t/g.tar" "reg:$G/new.json:644"
expect 1 "import-goldens: rename in the index rejected" "unexpected staged change D" ig
igreset; git -C "$g" update-index --chmod=+x "$G/a.json"; mktar "$t/g.tar" "reg:$G/new.json:644"
expect 1 "import-goldens: mode change rejected" "unexpected staged change M 100755" ig
igreset; mv "$g/$G" "$t/elsewhere"; ln -s "$t/elsewhere" "$g/$G"; mktar "$t/g.tar" "reg:$G/a.json:644"
expect 1 "import-goldens: symlinked golden directory rejected" "missing or redirected" ig
rm "$g/$G"; mv "$t/elsewhere" "$g/$G"

