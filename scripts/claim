#!/usr/bin/env bash
# Agent task queue (docs/agent-workflow.md "Agent task queue"): claim, release, expire claims.
#   scripts/claim <issue> <agent>             claim an agent-ready + up-for-grabs issue; exit 1 if lost
#   scripts/claim --release <issue> <agent>   give it back
#   scripts/claim --stale                     release claims idle for CLAIM_TTL seconds (default 24 h);
#                                             run by .github/workflows/stale-claims.yml
# Protocol, all in issue comments (first line of the body):
#   `CLAIM <agent> <UTC time>`    `RELEASE <agent> <UTC time>` (cancels that agent's claims)
#   `RELEASE (stale) <UTC time>` or a bare `RELEASE` (cancels every claim before it)
# The winner is the earliest CLAIM still live. Only comments by OWNER/MEMBER/COLLABORATOR accounts or
# github-actions[bot] count, so an outsider's comment can neither claim nor release.
# Env: GH_REPO (else the current repo), CLAIM_SETTLE (seconds before re-reading, default 3),
# CLAIM_NOW (epoch seconds, tests), CLAIM_TTL.
set -euo pipefail
die() { echo "claim: $*" >&2; exit "${2:-2}"; }
repo=${GH_REPO:-$(gh repo view --json nameWithOwner -q .nameWithOwner)}
now=${CLAIM_NOW:-$(date -u +%s)}
stamp() { date -u -d "@$now" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$now" +%Y-%m-%dT%H:%M:%SZ; }

# Live claims of a comment array, oldest first: [{id, login, at, agent}].
LIVE='[.[] | select(.author_association == "OWNER" or .author_association == "MEMBER"
        or .author_association == "COLLABORATOR" or .user.login == "github-actions[bot]")
      | {id, login: .user.login, at: .created_at, l: (.body | split("\n")[0] | split(" "))}]
  | sort_by(.id)
  | reduce .[] as $c ([];
      if $c.l[0] == "CLAIM" and ($c.l[1] // "" | test("^[A-Za-z0-9._-]{1,40}$")) then
        . + [$c | {id, login, at, agent: .l[1]}]
      elif $c.l[0] == "RELEASE" then
        ($c.l[1] // "") as $a
        | if $a == "" or ($a | startswith("(")) then [] else map(select(.agent != $a)) end
      else . end)'

comments() { gh api --paginate --slurp "repos/$repo/issues/$1/comments" | jq -c 'add // []'; }
say() { gh api -X POST "repos/$repo/issues/$1/comments" -f body="$2" >/dev/null; }
relabel() { # <issue> <add> <remove>
  gh api -X POST "repos/$repo/issues/$1/labels" -f "labels[]=$2" >/dev/null
  gh api -X DELETE "repos/$repo/issues/$1/labels/$3" >/dev/null 2>&1 || true  # absent label: fine
}
args() {
  [[ ${1:-} =~ ^[0-9]+$ ]] || die "issue must be a number"
  [[ ${2:-} =~ ^[A-Za-z0-9._-]{1,40}$ ]] || die "agent name must match [A-Za-z0-9._-]{1,40}"
}

claim() {
  local n=$1 agent=$2 labels first
  labels=$(gh api "repos/$repo/issues/$n" --jq 'if .state != "open" then "closed" else [.labels[].name] | join(",") end')
  case ",$labels," in
    ,closed,) die "#$n is closed" 1 ;;
    *,agent-ready,*) ;;
    *) die "#$n is not labelled agent-ready (maintainer gate)" 1 ;;
  esac
  [[ ,$labels, != *,claimed,* ]] || die "#$n is already claimed" 1
  [[ ,$labels, == *,up-for-grabs,* ]] || die "#$n is not up-for-grabs" 1
  [[ ,$labels, != *,blocked,* ]] || die "#$n is blocked" 1
  say "$n" "CLAIM $agent $(stamp)"
  sleep "${CLAIM_SETTLE:-3}"  # let concurrent claims land before deciding
  first=$(comments "$n" | jq -r "$LIVE | .[0].agent // empty")
  if [[ $first != "$agent" ]]; then
    say "$n" "RELEASE $agent $(stamp)"
    die "#$n lost to ${first:-nobody}" 1
  fi
  relabel "$n" claimed up-for-grabs
  echo "claimed #$n as $agent: branch issue-$n-<slug>, PR body 'Closes #$n'"
}

release() {
  local n=$1 agent=$2
  say "$n" "RELEASE $agent $(stamp)"
  if [[ $(comments "$n" | jq "$LIVE | length") == 0 ]]; then relabel "$n" up-for-grabs claimed; fi
  echo "released #$n"
}

# A claim is stale when, for CLAIM_TTL, there was no commit on a branch issue-<n>-*, no comment by
# the claiming account and no open PR from such a branch.
# ponytail: branch activity = committer date of the branch head, not push time (no push API for
# that); a rebase or amend refreshes it, an old commit pushed late does not.
stale() {
  local ttl=${CLAIM_TTL:-86400} n c last d sha heads
  heads=$(gh api --paginate --slurp "repos/$repo/pulls?state=open&per_page=100" | jq -c '[add // [] | .[].head.ref]')
  for n in $(gh api --paginate --slurp "repos/$repo/issues?state=open&labels=claimed&per_page=100" \
               | jq -r 'add // [] | .[] | select(.pull_request | not) | .number'); do
    c=$(comments "$n")
    last=$(jq -r "($LIVE | .[0]) as \$w | if \$w == null then 0 else
        [\$w.at, (.[] | select(.user.login == \$w.login and .id > \$w.id
                     and (.body | startswith(\"RELEASE\") | not)) | .created_at)]
        | map(fromdateiso8601) | max end" <<<"$c")
    if jq -e --arg p "issue-$n-" 'any(startswith($p))' <<<"$heads" >/dev/null; then continue; fi
    for sha in $(gh api "repos/$repo/git/matching-refs/heads/issue-$n-" --jq '.[].object.sha'); do
      d=$(gh api "repos/$repo/commits/$sha" --jq '.commit.committer.date | fromdateiso8601')
      if ((d > last)); then last=$d; fi
    done
    if ((now - last >= ttl)); then
      say "$n" "RELEASE (stale) $(stamp)"
      relabel "$n" up-for-grabs claimed
      echo "released stale claim on #$n"
    fi
  done
}

case ${1:-} in
  --release) args "${2:-}" "${3:-}"; release "$2" "$3" ;;
  --stale) stale ;;
  -*|"") die "usage: claim <issue> <agent> | --release <issue> <agent> | --stale" ;;
  *) args "$1" "${2:-}"; claim "$1" "$2" ;;
esac
